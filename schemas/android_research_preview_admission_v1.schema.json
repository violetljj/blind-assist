{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/violetljj/blind-assist/schemas/android_research_preview_admission_v1.schema.json",
  "title": "BlindAssist Android research-preview admission decision v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "protocol_version",
    "run_id",
    "contract",
    "evidence",
    "quality",
    "android_feasibility",
    "product_authority",
    "admission"
  ],
  "properties": {
    "schema_version": {
      "const": "blindassist_android_research_preview_admission_v1"
    },
    "protocol_version": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frozen_at",
        "candidate_id",
        "model_sha256",
        "export_sha256",
        "preprocess_sha256",
        "postprocess_sha256",
        "input_manifest_sha256",
        "input_shape",
        "state_reset",
        "supported_backend"
      ],
      "properties": {
        "frozen_at": {
          "type": "string",
          "format": "date-time"
        },
        "candidate_id": {
          "enum": [
            "DA2",
            "A2-392"
          ]
        },
        "model_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "export_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "preprocess_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "postprocess_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "input_manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "input_shape": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "state_reset": {
          "type": "string",
          "minLength": 1
        },
        "supported_backend": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "complete",
        "parent_session_disjoint",
        "opened_after_contract_freeze",
        "denominators_complete",
        "aggregates_finite",
        "per_parent_session_reported",
        "pooled_reported"
      ],
      "properties": {
        "complete": {
          "type": "boolean"
        },
        "parent_session_disjoint": {
          "type": "boolean"
        },
        "opened_after_contract_freeze": {
          "type": "boolean"
        },
        "denominators_complete": {
          "type": "boolean"
        },
        "aggregates_finite": {
          "type": "boolean"
        },
        "per_parent_session_reported": {
          "type": "boolean"
        },
        "pooled_reported": {
          "type": "boolean"
        }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "reason_codes",
        "metrics"
      ],
      "properties": {
        "decision": {
          "$ref": "#/$defs/gateDecision"
        },
        "reason_codes": {
          "$ref": "#/$defs/reasonCodes"
        },
        "metrics": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "false_clear",
            "false_block",
            "known_coverage",
            "clearance_error",
            "transition_consistency"
          ],
          "properties": {
            "false_clear": {
              "type": [
                "number",
                "null"
              ]
            },
            "false_block": {
              "type": [
                "number",
                "null"
              ]
            },
            "known_coverage": {
              "type": [
                "number",
                "null"
              ]
            },
            "clearance_error": {
              "type": [
                "number",
                "null"
              ]
            },
            "transition_consistency": {
              "type": [
                "number",
                "null"
              ]
            }
          }
        }
      }
    },
    "android_feasibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "reason_codes",
        "requested_backend",
        "observed_backend",
        "fallback_observed",
        "reference_parity_within_bound",
        "cold_start_ms",
        "warm_start_ms",
        "latency_p50_ms",
        "latency_p95_ms",
        "peak_memory_mb",
        "thermal_window_seconds"
      ],
      "properties": {
        "decision": {
          "$ref": "#/$defs/gateDecision"
        },
        "reason_codes": {
          "$ref": "#/$defs/reasonCodes"
        },
        "requested_backend": {
          "type": "string",
          "minLength": 1
        },
        "observed_backend": {
          "type": [
            "string",
            "null"
          ]
        },
        "fallback_observed": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "reference_parity_within_bound": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "cold_start_ms": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "warm_start_ms": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "latency_p50_ms": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "latency_p95_ms": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "peak_memory_mb": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "thermal_window_seconds": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "product_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "authorized_scopes",
        "reason_codes"
      ],
      "properties": {
        "decision": {
          "const": "DENIED"
        },
        "authorized_scopes": {
          "type": "array",
          "maxItems": 0
        },
        "reason_codes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "admission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "authorized_scope",
        "terminal",
        "rescue_allowed",
        "reason_codes"
      ],
      "properties": {
        "decision": {
          "$ref": "#/$defs/gateDecision"
        },
        "authorized_scope": {
          "enum": [
            "NONE",
            "ANDROID_RESEARCH_PREVIEW_ONLY"
          ]
        },
        "terminal": {
          "const": true
        },
        "rescue_allowed": {
          "const": false
        },
        "reason_codes": {
          "$ref": "#/$defs/reasonCodes"
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "gateDecision": {
      "enum": [
        "PASS",
        "FAIL",
        "UNKNOWN"
      ]
    },
    "reasonCodes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
