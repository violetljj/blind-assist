{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/violetljj/blind-assist/schemas/android_research_preview_admission_v1.schema.json",
  "title": "BlindAssist Android research-preview admission receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "contract", "observed", "evidence", "quality", "android_feasibility", "product_authority", "admission"],
  "properties": {
    "schema_version": {"const": "blindassist_android_research_preview_admission_v1"},
    "run_id": {"type": "string", "minLength": 1},
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frozen_at", "candidate_id", "protocol", "thresholds", "roster", "identity", "supported_backend"],
      "properties": {
        "frozen_at": {"type": "string", "format": "date-time"},
        "candidate_id": {"enum": ["DA2", "A2-392"]},
        "protocol": {"$ref": "#/$defs/versionedBinding"},
        "thresholds": {
          "allOf": [
            {"$ref": "#/$defs/versionedBinding"},
            {
              "type": "object",
              "required": ["values"],
              "properties": {
                "values": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["false_clear", "false_block", "known_coverage", "clearance_error", "transition_consistency", "max_reference_parity_error"],
                  "properties": {
                    "false_clear": {"$ref": "#/$defs/finiteNumber"},
                    "false_block": {"$ref": "#/$defs/finiteNumber"},
                    "known_coverage": {"$ref": "#/$defs/finiteNumber"},
                    "clearance_error": {"$ref": "#/$defs/finiteNumber"},
                    "transition_consistency": {"$ref": "#/$defs/finiteNumber"},
                    "max_reference_parity_error": {"$ref": "#/$defs/finiteNumber"}
                  }
                }
              }
            }
          ]
        },
        "roster": {
          "allOf": [
            {"$ref": "#/$defs/versionedBinding"},
            {
              "type": "object",
              "required": ["roles"],
              "properties": {
                "roles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
              }
            }
          ]
        },
        "identity": {"$ref": "#/$defs/identity"},
        "supported_backend": {"type": "string", "minLength": 1}
      }
    },
    "observed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "android"],
      "properties": {
        "identity": {"$ref": "#/$defs/nullableIdentity"},
        "android": {
          "type": "object",
          "additionalProperties": false,
          "required": ["observed_backend", "fallback_observed", "fallback_backend", "reference_parity", "cold_start_ms", "warm_start_ms", "latency_p50_ms", "latency_p95_ms", "peak_memory_mb", "thermal_window_seconds"],
          "properties": {
            "observed_backend": {"type": ["string", "null"]},
            "fallback_observed": {"type": ["boolean", "null"]},
            "fallback_backend": {"type": ["string", "null"]},
            "reference_parity": {
              "type": "object",
              "additionalProperties": false,
              "required": ["runtime_sha256", "measured_max_abs_error"],
              "properties": {
                "runtime_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
                "measured_max_abs_error": {"anyOf": [{"$ref": "#/$defs/finiteNumber"}, {"type": "null"}]}
              }
            },
            "cold_start_ms": {"anyOf": [{"$ref": "#/$defs/finiteNumber"}, {"type": "null"}]},
            "warm_start_ms": {"anyOf": [{"$ref": "#/$defs/finiteNumber"}, {"type": "null"}]},
            "latency_p50_ms": {"anyOf": [{"$ref": "#/$defs/finiteNumber"}, {"type": "null"}]},
            "latency_p95_ms": {"anyOf": [{"$ref": "#/$defs/finiteNumber"}, {"type": "null"}]},
            "peak_memory_mb": {"anyOf": [{"$ref": "#/$defs/finiteNumber"}, {"type": "null"}]},
            "thermal_window_seconds": {"anyOf": [{"$ref": "#/$defs/finiteNumber"}, {"type": "null"}]}
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["complete", "opened_after_contract_freeze", "parent_session_disjoint", "parent_sessions", "pooled"],
      "properties": {
        "complete": {"type": "boolean"},
        "opened_after_contract_freeze": {"type": "boolean"},
        "parent_session_disjoint": {"type": "boolean"},
        "parent_sessions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/parentSession"}},
        "pooled": {"$ref": "#/$defs/aggregate"}
      }
    },
    "quality": {"$ref": "#/$defs/subDecision"},
    "android_feasibility": {"$ref": "#/$defs/subDecision"},
    "product_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "authorized_scopes", "reason_codes"],
      "properties": {
        "decision": {"const": "DENIED"},
        "authorized_scopes": {"type": "array", "maxItems": 0},
        "reason_codes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "admission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "authorized_scope", "terminal", "rescue_allowed", "reason_codes"],
      "properties": {
        "decision": {"enum": ["PASS", "FAIL", "UNKNOWN"]},
        "authorized_scope": {"enum": ["ANDROID_RESEARCH_PREVIEW_ONLY", "NONE"]},
        "terminal": {"const": true},
        "rescue_allowed": {"const": false},
        "reason_codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "finiteNumber": {"type": "number"},
    "versionedBinding": {
      "type": "object",
      "required": ["version", "sha256"],
      "properties": {
        "version": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_sha256", "export_sha256", "preprocess_sha256", "postprocess_sha256", "input_manifest_sha256"],
      "properties": {
        "model_sha256": {"$ref": "#/$defs/sha256"},
        "export_sha256": {"$ref": "#/$defs/sha256"},
        "preprocess_sha256": {"$ref": "#/$defs/sha256"},
        "postprocess_sha256": {"$ref": "#/$defs/sha256"},
        "input_manifest_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "nullableIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_sha256", "export_sha256", "preprocess_sha256", "postprocess_sha256", "input_manifest_sha256"],
      "properties": {
        "model_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "export_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "preprocess_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "postprocess_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "input_manifest_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}
      }
    },
    "qualityMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["false_clear", "false_block", "known_coverage", "clearance_error", "transition_consistency"],
      "properties": {
        "false_clear": {"$ref": "#/$defs/finiteNumber"},
        "false_block": {"$ref": "#/$defs/finiteNumber"},
        "known_coverage": {"$ref": "#/$defs/finiteNumber"},
        "clearance_error": {"$ref": "#/$defs/finiteNumber"},
        "transition_consistency": {"$ref": "#/$defs/finiteNumber"}
      }
    },
    "aggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["denominator", "metrics"],
      "properties": {
        "denominator": {"type": "integer", "minimum": 1},
        "metrics": {"$ref": "#/$defs/qualityMetrics"}
      }
    },
    "parentSession": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parent_id", "session_id", "denominator", "metrics"],
      "properties": {
        "parent_id": {"type": "string", "minLength": 1},
        "session_id": {"type": "string", "minLength": 1},
        "denominator": {"type": "integer", "minimum": 1},
        "metrics": {"$ref": "#/$defs/qualityMetrics"}
      }
    },
    "subDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "reason_codes"],
      "properties": {
        "decision": {"enum": ["PASS", "FAIL", "UNKNOWN"]},
        "reason_codes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
