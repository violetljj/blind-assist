{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blindassist.local/schemas/metric_traversability_field_r0.schema.json",
  "title": "BlindAssist HFTF MetricTraversabilityField R0",
  "type": "object",
  "required": [
    "schema",
    "authority",
    "status",
    "unknown_reasons",
    "calibrated_depth",
    "ground_plane",
    "clearance_profile",
    "sweep_envelopes",
    "intrusion_regions",
    "best_observed_clearance_direction",
    "temporal_trend",
    "quality",
    "claim_ceiling"
  ],
  "properties": {
    "schema": { "const": "blindassist_hftf_metric_traversability_field_r0" },
    "authority": { "const": "DEVELOPMENT_ONLY_SHADOW_DEMO" },
    "status": { "enum": ["VALID", "UNKNOWN"] },
    "unknown_reasons": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "calibrated_depth": {
      "type": "object",
      "required": ["available", "unit", "source_model", "metric_scale_status", "finite_fraction"],
      "properties": {
        "available": { "type": "boolean" },
        "unit": { "type": ["string", "null"], "enum": ["m", null] },
        "source_model": { "type": "string", "minLength": 1 },
        "metric_scale_status": { "type": ["string", "null"] },
        "scale": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "anchor_age_ns": { "type": ["integer", "null"], "minimum": 0 },
        "anchor_source": { "type": ["string", "null"] },
        "finite_fraction": { "type": "number", "minimum": 0, "maximum": 1 },
        "p05_m": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "p50_m": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "p95_m": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "retention": { "type": "string" }
      }
    },
    "ground_plane": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["source", "normal_camera", "camera_height_m", "median_residual_m"],
          "properties": {
            "source": { "type": "string" },
            "normal_camera": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 },
            "camera_height_m": { "type": "number", "exclusiveMinimum": 0 },
            "median_residual_m": { "type": "number", "minimum": 0 }
          }
        }
      ]
    },
    "clearance_profile": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["theta_deg", "nearest_intrusion_m", "risk_score", "known_score", "support_points", "observed_forward_m", "support_status", "provenance"],
        "properties": {
          "theta_deg": { "type": "integer", "exclusiveMinimum": -90, "exclusiveMaximum": 90 },
          "nearest_intrusion_m": { "type": ["number", "null"], "exclusiveMinimum": 0 },
          "risk_score": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
          "known_score": { "type": "number", "minimum": 0, "maximum": 1 },
          "intrusion_points": { "type": "integer", "minimum": 0 },
          "support_points": { "type": "integer", "minimum": 0 },
          "observed_forward_m": { "type": "number", "minimum": 0 },
          "support_status": { "enum": ["SUPPORTED", "UNKNOWN_SUPPORT"] },
          "provenance": {
            "type": "object",
            "required": ["source_model", "geometry", "metric_scale_source"]
          }
        }
      }
    },
    "sweep_envelopes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["horizon_m", "body_half_width_m", "lateral_margin_m", "directions"],
        "properties": {
          "horizon_m": { "type": "number", "exclusiveMinimum": 0 },
          "body_half_width_m": { "type": "number", "exclusiveMinimum": 0 },
          "lateral_margin_m": { "type": "number", "minimum": 0 },
          "directions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["theta_deg", "state"],
              "properties": {
                "theta_deg": { "type": "integer" },
                "state": { "enum": ["OCCUPIED_OBSERVED", "CLEAR_OBSERVED", "UNKNOWN_SUPPORT"] }
              }
            }
          }
        }
      }
    },
    "intrusion_regions": { "type": "array", "items": { "type": "object" } },
    "best_observed_clearance_direction": { "type": ["object", "null"] },
    "temporal_trend": { "type": "object", "required": ["status"] },
    "quality": {
      "type": "object",
      "required": ["image_quality", "depth_finite_fraction", "depth_support_pass", "ground_support_pass", "direction_support_fraction", "overall_confidence"],
      "properties": {
        "image_quality": {
          "type": "object",
          "required": ["status", "pass"],
          "properties": {
            "status": { "enum": ["PASS", "FAIL", "NOT_PROVIDED"] },
            "pass": { "type": ["boolean", "null"] },
            "laplacian_variance_320x240": { "type": "number", "minimum": 0 },
            "minimum_laplacian_variance": { "type": "number", "minimum": 0 },
            "underexposed_fraction": { "type": "number", "minimum": 0, "maximum": 1 },
            "overexposed_fraction": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "depth_finite_fraction": { "type": "number", "minimum": 0, "maximum": 1 },
        "depth_support_pass": { "type": "boolean" },
        "ground_support_pass": { "type": "boolean" },
        "direction_support_fraction": { "type": "number", "minimum": 0, "maximum": 1 },
        "overall_confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "claim_ceiling": { "type": "string", "minLength": 1 }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "UNKNOWN" } } },
      "then": {
        "properties": {
          "unknown_reasons": { "minItems": 1 },
          "ground_plane": { "type": "null" },
          "clearance_profile": { "maxItems": 0 },
          "sweep_envelopes": { "maxItems": 0 },
          "best_observed_clearance_direction": { "type": "null" }
        }
      }
    }
  ]
}
