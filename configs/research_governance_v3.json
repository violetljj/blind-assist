{
  "schema_version": "blindassist.research_governance.v1",
  "policy_id": "RISK_TIERED_RESEARCH_GOVERNANCE_R3",
  "adopted_on": "2026-07-31",
  "policy_is_revisable": true,
  "user_guidance_is_revisable": true,
  "project_objective_priority": [
    "THESIS_AND_GRADUATION_SUFFICIENCY",
    "FALSIFIABLE_RESEARCH_LEARNING",
    "INFORMATION_GAIN_PER_UNIT_COST",
    "DEMONSTRABLE_PROTOTYPE_VALUE",
    "OPTIONAL_DEPLOYMENT_EVIDENCE"
  ],
  "rule_necessity_tests": [
    "INFORMATION_GAIN",
    "REPRODUCIBILITY",
    "CLAIM_INTEGRITY",
    "EXTERNAL_SAFETY_OR_LEGAL_REQUIREMENT"
  ],
  "unjustified_rule_default": "DOWNGRADE_TO_GUARDRAIL_OR_REMOVE",
  "efficiency_policy": {
    "default": "MINIMUM_SUFFICIENT_RIGOR",
    "allow_reversible_shortcuts": true,
    "allow_parallel_independent_work": true,
    "allow_lightweight_posthoc_recording_in_discovery": true,
    "forbidden_shortcuts": [
      "FABRICATE_OR_OVERSTATE_EVIDENCE",
      "LEAK_CONFIRMATION_OUTCOMES",
      "SILENTLY_REWRITE_PRIOR_RESULTS",
      "CREATE_UNDISCLOSED_IRREVERSIBLE_RISK"
    ],
    "escalation_rule": "Increase rigor only when claim scope, irreversibility, external risk or evidence contamination risk increases."
  },
  "execution_profiles": {
    "CANARY_LITE": {
      "default_stages": ["DISCOVERY", "CANARY"],
      "allowed_freeze_levels": ["F0", "F1"],
      "rerunnable_before_terminal": true,
      "one_shot_default": false,
      "full_hash_chain_default": false,
      "review_mode": "RISK_TIERED",
      "data_scope": "RANK_BY_FITNESS_AND_STOP_ON_ADEQUACY",
      "minimum_artifacts": [
        "QUESTION_AND_CLAIM_CEILING",
        "SOURCE_OR_INPUT_LEDGER",
        "MINIMAL_DISCRIMINATING_RESULT",
        "LIMITATIONS_AND_NEXT_ACTION"
      ]
    },
    "DEVELOPMENT_STANDARD": {
      "default_stages": ["DEVELOPMENT"],
      "allowed_freeze_levels": ["F1"],
      "rerunnable_before_frozen_holdout": true,
      "one_shot_default": false,
      "full_hash_chain_default": false,
      "review_mode": "CLAIM_CRITICAL_OR_SAMPLED_INDEPENDENT_REVIEW",
      "bounded_candidate_shortlist_default_max": 3,
      "selection_on_burned_development_data": true,
      "freeze_one_before_held_out_evaluation": true,
      "minimum_artifacts": [
        "CANARY_LITE_PACKAGE",
        "IMPLEMENTATION_IDENTITY",
        "FOCUSED_TESTS",
        "REPRODUCIBLE_INPUT_OUTPUT",
        "RESOURCE_BUDGET_AND_STOP_CONDITIONS"
      ]
    },
    "CONFIRMATION_STRICT": {
      "default_stages": ["CONFIRMATION", "DEPLOYMENT"],
      "allowed_freeze_levels": ["F2", "F3"],
      "rerunnable_after_outcome_access": false,
      "one_shot_when_justified_by_claim": true,
      "full_hash_chain_default": true,
      "review_mode": "INDEPENDENT_FULL_REVIEW",
      "bounded_candidate_shortlist_default_max": 1,
      "minimum_artifacts": [
        "DEVELOPMENT_STANDARD_PACKAGE",
        "FROZEN_PROTOCOL_AND_DATA_IDENTITY",
        "IMPLEMENTATION_AND_STATISTICAL_LOCK",
        "INDEPENDENT_VALIDATOR",
        "HASH_BOUND_RECEIPTS"
      ]
    }
  },
  "profile_selection_rules": {
    "default_by_stage": {
      "DISCOVERY": "CANARY_LITE",
      "CANARY": "CANARY_LITE",
      "DEVELOPMENT": "DEVELOPMENT_STANDARD",
      "CONFIRMATION": "CONFIRMATION_STRICT",
      "DEPLOYMENT": "CONFIRMATION_STRICT"
    },
    "escalation_requires_named_risk": true,
    "lower_stage_may_use_stricter_profile": true,
    "higher_stage_may_not_use_weaker_profile": true,
    "legacy_protocols_keep_bound_policy": true
  },
  "review_risk_policy": {
    "deterministic_metadata": "AUTOMATED_VALIDATION",
    "low_risk_observation": "SINGLE_AGENT_WITH_FROZEN_SAMPLED_AUDIT",
    "claim_critical_or_ambiguous_observation": "TWO_ISOLATED_AGENT_PASSES",
    "adjudication": "FRESH_THIRD_AGENT_ONLY_FOR_MATERIAL_DISAGREEMENT",
    "same_model_family_evidence_status": "OPERATIONAL_ISOLATION_NOT_INDEPENDENT_GROUND_TRUTH"
  },
  "failure_recording_policy": {
    "operational_or_control_plane_failure": "LIGHTWEIGHT_INCIDENT_RECEIPT",
    "scientific_failure_or_repeated_material_incident": "FULL_FAILURE_LEARNING_RECORD",
    "operational_invalidity_does_not_consume_scientific_hypothesis": true
  },
  "failure_record_modes": [
    "FULL_FAILURE_LEARNING",
    "LIGHTWEIGHT_OPERATIONAL_INCIDENT"
  ],
  "host_preflight_policy": {
    "guarded_runner_required_for": [
      "FORMAL_ONE_SHOT_OR_IRREVERSIBLE_CLAIM",
      "EXPECTED_WALL_TIME_OVER_15_MINUTES",
      "HIGH_IO_MEMORY_OR_DEVICE_RISK",
      "RUNTIME_NOT_BOUNDABLE_FROM_LIGHTWEIGHT_PILOT"
    ],
    "three_to_fifteen_minute_reversible_work": "LIGHTWEIGHT_TIMEOUT_PROGRESS_AND_OUTPUT_CONTRACT",
    "short_reversible_canary": "DIRECT_RUN_ALLOWED_WITH_SCOPED_OUTPUT"
  },
  "stages": {
    "DISCOVERY": {
      "minimum_freeze_level": "F0",
      "allowed_claims": ["CANDIDATE_FOUND", "CANDIDATE_NOT_FOUND", "DATA_CHARACTERIZED"],
      "confirmation_authority": false
    },
    "CANARY": {
      "minimum_freeze_level": "F1",
      "allowed_claims": [
        "MECHANISM_DIRECTION_SUPPORTED",
        "MECHANISM_DIRECTION_NOT_SUPPORTED",
        "IMPLEMENTATION_DEBUGGED",
        "NOT_EVALUABLE"
      ],
      "confirmation_authority": false
    },
    "DEVELOPMENT": {
      "minimum_freeze_level": "F1",
      "allowed_claims": [
        "IMPLEMENTATION_READY_FOR_CONFIRMATION",
        "IMPLEMENTATION_NOT_READY",
        "NOT_EVALUABLE"
      ],
      "confirmation_authority": false
    },
    "CONFIRMATION": {
      "minimum_freeze_level": "F2",
      "allowed_claims": ["CONFIRM_PASS", "CONFIRM_FAIL", "NOT_EVALUABLE"],
      "confirmation_authority": true
    },
    "DEPLOYMENT": {
      "minimum_freeze_level": "F3",
      "allowed_claims": ["DEPLOYMENT_GATE_PASS", "DEPLOYMENT_GATE_FAIL", "NOT_EVALUABLE"],
      "confirmation_authority": true
    }
  },
  "research_tracks": {
    "CAPABILITY_DISCOVERY": {
      "allowed_stages": ["DISCOVERY", "CANARY"],
      "purpose": "Characterize accessible data, response patterns and failure modes."
    },
    "DEVELOPMENT_DIAGNOSTIC": {
      "allowed_stages": ["CANARY", "DEVELOPMENT"],
      "purpose": "Change implementation, select diagnostics or tune on explicitly contaminated data."
    },
    "SEALED_EVALUATION": {
      "allowed_stages": ["CONFIRMATION"],
      "purpose": "Evaluate a frozen question and implementation on session-level unseen outcomes."
    },
    "EXTERNAL_TRANSFER": {
      "allowed_stages": ["CONFIRMATION"],
      "purpose": "Test transfer across source, device or distribution after ordinary holdout evaluation."
    }
  },
  "result_access_states": ["CONTENT_INSPECTED", "OUTPUT_INSPECTED", "TUNED_ON", "SEALED_UNSEEN"],
  "independence_units": ["PERSON", "CAPTURE_SESSION", "ROUTE", "SEQUENCE"],
  "capability_map_columns": [
    "dataset_id",
    "sequence_id",
    "scene_motion",
    "available_modalities",
    "observation_unit",
    "access_cost",
    "outcome_access_state",
    "assigned_role",
    "claim_ceiling",
    "notes"
  ],
  "freeze_levels": ["F0", "F1", "F2", "F3"],
  "constraint_classes": ["INVARIANT", "GATE", "GUARDRAIL", "DIAGNOSTIC", "ASSUMPTION"],
  "data_roles": ["DISCOVERY", "CANARY", "DEVELOPMENT", "CONFIRMATION", "DEPLOYMENT"],
  "outcome_access_levels": ["NONE", "METADATA_ONLY", "GEOMETRY_ONLY", "FULL"],
  "failure_scopes": [
    "ITEM",
    "WINDOW",
    "SEQUENCE",
    "BRANCH",
    "IMPLEMENTATION_VERSION",
    "EVIDENCE_VERSION",
    "RESEARCH_QUESTION",
    "PRODUCT"
  ],
  "amendment_modes": ["IN_PLACE_BEFORE_OUTCOME", "NEW_VERSION_ONLY"],
  "execution_validity_values": ["VALID", "INVALID", "NOT_RUN"],
  "not_run_scientific_outcome": "NOT_RUN",
  "invalid_execution_scientific_outcome": "NOT_EVALUABLE_DUE_TO_EXECUTION",
  "constraint_operators": ["GT", "GTE", "LT", "LTE", "EQ", "NEQ", "RANGE_INCLUSIVE"],
  "required_data_partition_fields": [
    "source_identity",
    "content_identity",
    "identity_basis",
    "independence_group",
    "ancestry",
    "reuse_policy"
  ],
  "scientific_question_states": ["OPEN", "CLOSED", "RETIRED"],
  "protocol_version_states": ["OPEN", "CLOSED_VALID", "CLOSED_INVALID", "SUPERSEDED"],
  "artifact_integrity_states": ["VALID", "INVALID"],
  "closure_execution_states": ["NOT_RUN", "COMPLETED", "CONSUMED_CLOSED"],
  "authority_ceilings": [
    "NONE",
    "DIAGNOSTIC",
    "DISCOVERY",
    "CANARY",
    "DEVELOPMENT",
    "CONFIRMATION",
    "DEPLOYMENT"
  ],
  "closure_target_types": [
    "scientific_question",
    "protocol_version",
    "evidence_instance",
    "dependency_branch"
  ],
  "question_closure_bases": [
    "independent_confirmatory_failure",
    "theoretical_refutation",
    "scope_retired_by_decision"
  ],
  "required_evidence_hash_fields": ["run_claim_sha256", "ledger_sha256", "receipt_sha256"],
  "failure_asset_roles": [
    "NEGATIVE_EVIDENCE",
    "DIAGNOSTIC",
    "REGRESSION_FIXTURE",
    "CANARY",
    "COUNTEREXAMPLE",
    "STRESS_CASE",
    "SOURCE_CHARACTERIZATION",
    "AUXILIARY_FEATURE",
    "QUALITY_GATE",
    "UNCERTAINTY_SIGNAL",
    "NEGATIVE_SAMPLE",
    "CONTROL_BASELINE",
    "ABLATION_COMPONENT",
    "DO_NOT_REUSE"
  ],
  "rule_challenge_dispositions": [
    "ACCEPTED_NEW_VERSION",
    "REJECTED_WITH_RATIONALE",
    "TRIAL_AS_GUARDRAIL",
    "NEEDS_MORE_EVIDENCE"
  ],
  "default_invalid_execution_effect": "CLOSE_EVIDENCE_VERSION_ONLY",
  "minimum_numeric_constraint_fields": [
    "unit",
    "rationale",
    "calibration_source",
    "sensitivity_plan",
    "revision_policy"
  ],
  "hard_rules": {
    "canary_or_development_data_must_not_be_confirmation_data": true,
    "post_outcome_amendment_requires_new_version": true,
    "confirmation_requires_at_least_one_gate": true,
    "confirmation_numeric_gates_require_full_justification": true,
    "invalid_execution_does_not_close_research_question_by_default": true,
    "legacy_evidence_is_immutable": true,
    "failure_requires_learning_record": true,
    "blind_cartesian_search_requires_explicit_justification": true,
    "rules_may_be_challenged_but_not_silently_bypassed": true,
    "failed_assets_may_be_reused_only_with_explicit_new_role": true,
    "content_inspection_does_not_burn_algorithm_outcome": true,
    "same_source_independent_session_may_be_confirmation": true,
    "random_frame_or_clip_split_is_not_independent": true,
    "capability_map_is_not_an_execution_gate": true,
    "one_source_need_not_answer_every_question": true,
    "external_transfer_is_separate_from_ordinary_holdout": true
  },
  "required_failure_learning_fields": [
    "failure_class",
    "observation",
    "inference",
    "alternative_explanations",
    "constraint_challenges",
    "next_hypotheses",
    "reuse_candidates",
    "information_gain"
  ],
  "required_hypothesis_fields": [
    "hypothesis_id",
    "theoretical_or_empirical_basis",
    "causal_difference",
    "expected_information_gain",
    "minimal_test",
    "evaluation_metric",
    "falsifier",
    "cost",
    "resource_budget",
    "stop_condition",
    "selection_reason"
  ],
  "required_experiment_design_fields": [
    "search_strategy",
    "minimal_discriminating_experiment",
    "resource_budget",
    "stop_conditions"
  ],
  "required_round_summary_fields": [
    "new_facts_and_evidence",
    "weakened_or_rejected_hypotheses",
    "unresolved_questions",
    "reusable_assets",
    "next_high_information_experiments",
    "governance_changes_needed"
  ],
  "material_change_dimensions": [
    "DATA",
    "INPUT_SIGNAL",
    "COMPENSATION",
    "SYSTEM_ROLE",
    "EVALUATION_TARGET",
    "DEPLOYMENT_CONDITION"
  ]
}
