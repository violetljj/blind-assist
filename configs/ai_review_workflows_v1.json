{
  "schema": "blindassist_ai_review_workflows_v1",
  "execution_surface": "current_codex_or_gpt_session",
  "api_key_required": false,
  "autonomous_scope": [
    "source_discovery_and_acquisition",
    "collection_orchestration",
    "annotation",
    "review",
    "adjudication",
    "privacy_and_quality_screening",
    "data_admission",
    "experiment_acceptance",
    "release_evidence_review"
  ],
  "human_required_queue_forbidden": true,
  "public_download_research_policy": {
    "ordinary_public_download_is_sufficient_for_isolated_internal_research": true,
    "separate_license_privacy_or_consent_receipt_required_before_download": false,
    "separate_license_privacy_or_consent_receipt_required_before_internal_training_or_offline_evaluation": false,
    "minimum_provenance": ["source_url", "retrieved_at", "content_sha256"],
    "allowed_retrieval": ["official_url_or_api", "public_mirror", "archive_service", "resumable_downloader"],
    "forbidden_retrieval": ["authentication_bypass", "payment_bypass", "access_control_evasion", "technical_restriction_evasion"],
    "separate_boundary_review": ["external_upload", "sharing_or_redistribution", "commercial_release", "production_promotion", "claim_of_participant_consent"]
  },
  "default_policy": {
    "required_independent_reviews": 2,
    "required_roles": ["gpt_task_reviewer", "codex_evidence_reviewer"],
    "fresh_context_per_review": true,
    "other_review_hidden": true,
    "input_and_prompt_sha256_required": true,
    "minimum_confidence": 0.65,
    "abstain_supported": true,
    "disagreement_policy": "fresh_third_model_adjudication",
    "unresolved_policy": "fail_closed_and_continue_other_work_without_requesting_human_review"
  },
  "workflows": {
    "autonomous_source_acquisition_v1": {
      "gpt_role": "source_content_continuity_and_privacy_risk_disclosure",
      "codex_role": "public_reachability_provenance_download_or_device_receipt_and_hash_review",
      "uncertainty_behavior": "record_missing_rights_or_privacy_metadata_as_limitation_and_continue_isolated_internal_research",
      "authority": "isolated_internal_research_source_admission"
    },
    "evalset_visual_semantics_v1": {
      "gpt_role": "multimodal_scene_risk_and_residual_pii_review",
      "codex_role": "manifest_provenance_and_cross_frame_consistency_review",
      "authority": "benchmark_data_admission"
    },
    "sanpo_p3_intake_v1": {
      "gpt_role": "multimodal_scene_mask_and_residual_pii_review",
      "codex_role": "consent_receipt_hash_taxonomy_and_session_isolation_review",
      "authority": "research_dataset_admission"
    },
    "ustrf_event_review_v1": {
      "gpt_role": "causal_multiframe_route_event_and_lifecycle_review",
      "codex_role": "evidence_binding_route_relation_and_protocol_review",
      "authority": "model_consensus_event_truth"
    },
    "central_obstruction_agent_label_readiness_d0a_v1": {
      "gpt_role": "isolated_multimodal_central_obstruction_observation_and_event_boundary_review",
      "codex_role": "isolated_multiframe_observation_manifest_parent_event_and_evidence_binding_review",
      "candidate_output_hidden_from_reviewers": true,
      "review_label_vocabulary": [
        "VISIBLE_CENTRAL_OBSTRUCTION_PRESENT",
        "NO_VISIBLE_CENTRAL_OBSTRUCTION_EVIDENCE",
        "NOT_EVALUABLE"
      ],
      "disagreement_policy": "fresh_third_model_independent_label_then_hash_bound_adjudication",
      "unresolved_policy": "quarantine_affected_item_as_not_evaluable_without_human_queue",
      "authority": "MODEL_ADJUDICATED_OBSERVATION_LABELS_CANARY_ONLY"
    },
    "metric_geometry_review_v1": {
      "gpt_role": "plots_coverage_and_failure_case_review",
      "codex_role": "raw_receipt_metric_threshold_and_identity_review",
      "authority": "isolated_geometry_shadow_admission"
    },
    "sanpo_release_review_v1": {
      "gpt_role": "worst_case_event_and_user_risk_review",
      "codex_role": "full_gate_hash_release_and_regression_review",
      "minimum_confidence": 0.75,
      "authority": "production_model_replacement_authorization"
    }
  },
  "non_review_facts": {
    "must_come_from_the_real_actor_or_device": [
      "participant_consent",
      "license_or_rights_grant",
      "device_produced_physical_measurement",
      "credential_or_signing_identity"
    ],
    "missing_fact_policy": "for_publicly_downloadable_data_continue_isolated_internal_research_and_mark_unknown; fail_only_the_external_upload_redistribution_commercial_production_or_corresponding_rights_claim_branch",
    "note": "Models never fabricate the underlying fact. Missing license, consent, or privacy metadata does not block ordinary public download or isolated internal research."
  }
}
