{
  "$schema": "../schemas/ustrf_route_target_l3_confirmation_lockbox_template_r1.schema.json",
  "schema": "blindassist_ustrf_route_target_l3_confirmation_lockbox_template_r1",
  "stage": "R2-L1X-L3T",
  "status": "NON_EXECUTABLE_TEMPLATE_ONLY",
  "frozen_on": "2026-07-24",
  "executable": false,
  "candidate_id": null,
