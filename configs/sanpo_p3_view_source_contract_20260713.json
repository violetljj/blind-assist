{
  "format": "blindassist_sanpo_p3_view_source_contract_v1",
  "effective_date": "2026-07-13",
  "target_domain": {
    "name": "forward_egocentric_rgb_navigation",
    "p3_metric_eligible_capture": [
      "consented_phone_chest_forward_rgb",
      "consented_phone_handheld_forward_rgb",
      "sanpo_camera_chest_left",
      "sanpo_camera_head_left"
    ],
    "required_sequence_invariants": ["source_id", "native_session_id", "camera", "lens", "source_width", "source_height", "official_split_or_consent_receipt", "annotation_quality"],
    "split_key": "source_id:native_session_id",
    "forbid_cross_split_views_of_same_native_session": true,
    "sanpo_required_original_resolution_pairs": [[2208, 1242], [1920, 1080]],
    "consented_phone_resolution_policy": "record source_width/source_height per row; require a hash-bound, constant native resolution within each session",
    "resized_training_input_is_not_source_resolution": true
  },
  "sanpo_view_policy": {
    "allowed_views": [
      {"camera": "camera_chest", "lens": "left", "priority": 1},
      {"camera": "camera_head", "lens": "left", "priority": 2}
    ],
    "selection_rule": "prefer the first allowed view with official aligned segmentation masks; select exactly one view per native session",
    "head_cross_view_gate_required": true,
    "head_samples_must_not_silently_mix_with_chest_canonical": true,
    "forbidden_lenses": ["right"],
    "source_split": "official_train_only",
    "license": "CC BY 4.0",
    "privacy": "retain source receipt and residual-PII review; keep original RGB and masks outside Git"
  },
  "source_tiers": [
    {"source_id": "sanpo_real_v0", "tier": "p3_canonical_candidate", "status": "approved_subject_to_view_policy", "role": "real egocentric segmentation"},
    {"source_id": "consented_forward_phone_v1", "tier": "p3_canonical_candidate", "status": "intake_required", "role": "target-domain coverage", "required_before_use": ["consent receipt", "residual-PII review", "pixel mask", "session split"]},
    {"source_id": "mapillary_vistas", "tier": "auxiliary_pretraining_only", "status": "license_snapshot_required", "role": "street semantic prior; never P3 metrics", "required_before_use": ["dataset-specific license snapshot", "commercial and redistribution review", "class-map and privacy receipt"]},
    {"source_id": "bdd100k", "tier": "candidate_not_approved", "status": "license_unverified", "role": "driving-video candidate; no download or use"},
    {"source_id": "cityscapes", "tier": "research_only_control", "status": "noncommercial_only", "role": "forbidden from product-training path and P3 metrics"},
    {"source_id": "guidetwsi_sdome_15k", "tier": "synthetic_or_procedural_augmentation_only", "status": "existing_controlled_adapter", "role": "cannot substitute for real target-domain sessions"}
  ],
  "reporting": {
    "required_strata": ["camera", "source_width_x_height", "source_id", "scene_bucket", "annotation_quality"],
    "required_dev_readouts": ["global", "macro_session", "worst_scene", "chest_only", "head_only", "camera_x_scene"],
    "blind_access": "not_accessed_by_source_intake_or_trainer"
  }
}
