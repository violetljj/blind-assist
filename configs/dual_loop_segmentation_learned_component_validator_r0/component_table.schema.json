{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "blindassist.dual_loop_segmentation_learned_component_validator_r0.component_table.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "protocol_id",
    "identity",
    "features",
    "target",
    "diagnostic"
  ],
  "properties": {
    "schema_version": {
      "const": "blindassist.dual_loop_segmentation_learned_component_validator_r0.component_table.v1"
    },
    "protocol_id": {
      "const": "DUAL_LOOP_SEGMENTATION_LEARNED_COMPONENT_VALIDATOR_R0"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_id",
        "view_row_id",
        "source_id",
        "session_id",
        "sequence_id",
        "frame_id",
        "source_capture_timestamp_ns",
        "role",
        "predicted_class",
        "component_index"
      ],
      "properties": {
        "component_id": {"type": "string"},
        "view_row_id": {"type": "string"},
        "source_id": {"type": "string"},
        "session_id": {"type": "string"},
        "sequence_id": {"type": "string"},
        "frame_id": {"type": "integer"},
        "source_capture_timestamp_ns": {"type": "integer"},
        "role": {"type": "string"},
        "predicted_class": {
          "enum": ["boundary_step_curb", "obstacle"]
        },
        "component_index": {"type": "integer", "minimum": 0}
      }
    },
    "features": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      },
      "minProperties": 21,
      "maxProperties": 21
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "keep_label",
        "same_class_residual_truth_intersection_pixels"
      ],
      "properties": {
        "keep_label": {
          "type": "integer",
          "enum": [0, 1]
        },
        "same_class_residual_truth_intersection_pixels": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "atlas_false_activation",
        "atlas_mechanism_tags",
        "raw_area_pixels",
        "raw_bbox_xyxy"
      ],
      "properties": {
        "atlas_false_activation": {"type": "boolean"},
        "atlas_mechanism_tags": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        },
        "raw_area_pixels": {
          "type": "integer",
          "minimum": 1
        },
        "raw_bbox_xyxy": {
          "type": "array",
          "prefixItems": [
            {"type": "integer"},
            {"type": "integer"},
            {"type": "integer"},
            {"type": "integer"}
          ],
          "minItems": 4,
          "maxItems": 4
        }
      }
    }
  }
}
