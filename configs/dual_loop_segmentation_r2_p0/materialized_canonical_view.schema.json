{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "blindassist.dual_loop_segmentation_r2_p0.materialized_canonical_view_row.v1",
  "type": "object",
  "required": [
    "schema_version",
    "protocol_id",
    "id",
    "role",
    "source_id",
    "session_id",
    "frame_id",
    "image_repo_relative_path",
    "image_sha256",
    "source_mask_repo_relative_path",
    "source_mask_sha256",
    "source_mask_decoder",
    "canonical_mask_path",
    "canonical_mask_sha256",
    "canonical_width",
    "canonical_height",
    "canonical_ids",
    "canonicalizer_code_sha256",
    "canonicalizer_config_sha256",
    "canonical_view_schema_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "blindassist.dual_loop_segmentation_r2_p0.materialized_canonical_view_row.v1"
    },
    "protocol_id": {"const": "DUAL_LOOP_SEGMENTATION_R2_P0"},
    "id": {"type": "string", "minLength": 1},
    "role": {
      "enum": ["train", "dev", "consumed_old_blind", "r1_consumed_fresh", "synthetic_canary"]
    },
    "source_id": {"type": "string", "minLength": 1},
    "session_id": {"type": "string", "minLength": 1},
    "frame_id": {"type": "integer", "minimum": 0},
    "image_repo_relative_path": {"type": ["string", "null"]},
    "image_sha256": {"type": ["string", "null"]},
    "source_mask_repo_relative_path": {"type": "string", "minLength": 1},
    "source_mask_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_mask_decoder": {"enum": ["source_native", "canonical_passthrough"]},
    "canonical_mask_path": {"type": "string", "minLength": 1},
    "canonical_mask_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "canonical_width": {"const": 256},
    "canonical_height": {"const": 256},
    "canonical_ids": {
      "type": "array",
      "items": {"enum": [0, 1, 2, 3]},
      "uniqueItems": true
    },
    "canonicalizer_code_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "canonicalizer_config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "canonical_view_schema_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": true
}
