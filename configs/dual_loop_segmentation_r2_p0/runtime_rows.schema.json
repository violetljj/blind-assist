{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "blindassist.dual_loop_segmentation_r2_p0.runtime_row.v1",
  "type": "object",
  "required": [
    "schema_version",
    "protocol_id",
    "candidate_id",
    "source_id",
    "frame_id",
    "image_sha256",
    "measurement_index",
    "stages_ms"
  ],
  "properties": {
    "schema_version": {"const": "blindassist.dual_loop_segmentation_r2_p0.runtime_row.v1"},
    "protocol_id": {"const": "DUAL_LOOP_SEGMENTATION_R2_P0"},
    "candidate_id": {"type": "string", "minLength": 1},
    "source_id": {"type": "string", "minLength": 1},
    "frame_id": {"type": "integer", "minimum": 0},
    "image_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "measurement_index": {"type": "integer", "minimum": 0},
    "stages_ms": {
      "type": "object",
      "properties": {
        "preprocess": {"type": "number", "minimum": 0},
        "tflite_inference": {"type": "number", "minimum": 0},
        "output_dequantize_argmax": {"type": "number", "minimum": 0},
        "component_extraction": {"type": "number", "minimum": 0},
        "fusion_operator": {"type": "number", "minimum": 0},
        "total_increment": {"type": "number", "minimum": 0}
      },
      "required": [
        "preprocess",
        "tflite_inference",
        "output_dequantize_argmax",
        "component_extraction",
        "fusion_operator",
        "total_increment"
      ],
      "additionalProperties": false
    }
  }
}
