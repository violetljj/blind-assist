  "authority_classification": {
    "schema": "blindassist-evidence-authority-classification-v1",
    "description": "Fail-closed migration rules for legacy unknown evidence authority. Automatic rules never assign reserved, fresh, or sealed_final.",
    "current_authority_sources": [
      "docs/PROJECT_STATE.md",
      "docs/CURRENT_DECISION.md",
      "research/active/dtr-r0/README.md",
      "research/active/l10-r0/README.md"
    ],
    "outcome_reference_markers": [
      "result",
      "results",
      "prediction",
      "predictions",
      "metric",
      "metrics",
      "scorecard",
      "verdict",
      "observation",
      "observations",
      "provider",
      "ledger",
      "ledgers",
      "receipt",
      "review",
      "report",
      "summary",
      "terminal"
    ],
    "artifact_assertion_text_extensions": [
      ".json",
      ".jsonl",
      ".md",
      ".txt",
      ".csv",
      ".toml",
      ".yaml",
      ".yml",
      ".log"
    ],
    "artifact_assertion_max_bytes": 1048576,
    "protected_authority_tokens": [
      "sealed_final"
    ],
    "current_outcome_reference_rule": {
      "rule_id": "current-authority-outcome-reference-v1",
      "evidence_status": "development_consumed",
      "claim_ceiling": "DEVELOPMENT_ONLY_NO_FRESH_CONFIRMATION_AUTHORITY",
      "reason": "A current authority document directly cites an outcome-bearing locator inside this evidence asset."
    },
    "artifact_assertion_rules": [
      {
        "rule_id": "artifact-explicit-development-consumed-v1",
        "evidence_status": "development_consumed",
        "claim_ceiling": "DEVELOPMENT_ONLY_NO_FRESH_CONFIRMATION_AUTHORITY",
        "reason": "An outcome/receipt artifact explicitly declares consumed or Development-only authority.",
        "tokens": [
          "development_consumed",
          "development_only",
          "development-only",
          "consumed"
        ]
      },
      {
        "rule_id": "artifact-explicit-diagnostic-only-v1",
        "evidence_status": "diagnostic",
        "claim_ceiling": "DIAGNOSTIC_ONLY_NO_FRESH_CONFIRMATION_AUTHORITY",
        "reason": "An outcome/receipt artifact explicitly declares diagnostic-only authority.",
        "tokens": [
          "diagnostic_only",
          "diagnostic-only"
        ]
      }
    ],
    "static_type_rules": [
      {
        "rule_id": "static-source-material-v1",
        "asset_classes": [
          "data",
          "source_payload"
        ],
        "evidence_status": "source_material",
        "claim_ceiling": "SOURCE_MATERIAL_ONLY_NO_FRESH_OR_CONFIRMATION_AUTHORITY",
        "reason": "The asset is source/observation material; claim-specific admission and run consumption are separate events."
      },
      {
        "rule_id": "static-not-applicable-v1",
        "asset_classes": [
          "model",
          "external_dependency"
        ],
        "evidence_status": "not_applicable",
        "claim_ceiling": "EVIDENCE_AUTHORITY_NOT_APPLICABLE",
        "reason": "The asset is a model or external dependency, not an evaluation cohort or outcome-bearing evidence asset."
      }
    ],
    "exact_rules": [
      {
        "rule_id": "exact-artvideo-development-input-v1",
        "locator": "datasets/artvideo-l10-r0",
        "evidence_status": "development_consumed",
        "claim_ceiling": "DEVELOPMENT_ONLY_NO_FRESH_CONFIRMATION_AUTHORITY",
        "reason": "The current L10 authority route records this exact dataset as input to completed cached Development results.",
        "authority_source": "research/active/l10-r0/README.md",
        "authority_anchors": [
          "--dataset artifacts.local/datasets/artvideo-l10-r0",
          "The cached Development result can be reproduced"
        ]
      },
      {
        "rule_id": "exact-dtr-r0-jrdb-bridge-consumed-v1",
        "locator": "datasets/dtr-r0-jrdb-rgb-bridge-v1",
        "evidence_status": "development_consumed",
        "claim_ceiling": "DEVELOPMENT_ONLY_NO_FRESH_CONFIRMATION_AUTHORITY",
        "reason": "The current DTR authority route records this exact source pack as input to the completed consumed M1/C1 chain.",
        "authority_source": "research/active/dtr-r0/README.md",
        "authority_anchors": [
          "--labels-zip artifacts.local/datasets/dtr-r0-jrdb-rgb-bridge-v1/train_labels.zip",
          "DTR_M1_O_POINT_VELOCITY_ORACLE_CEILING_NOT_MET_CLOSE_SCENE_FLOW_ROUTE"
        ]
      }
    ]
  },
