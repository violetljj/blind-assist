      <Parameter><Name>epsilon</Name><Mandatory>false</Mandatory><Datatype>QNN_DATATYPE_FLOAT_32</Datatype><Shape><Rank>SCALAR</Rank></Shape><Default>0.00001</Default></Parameter>
      <SupportedBackend>HTP</SupportedBackend>
