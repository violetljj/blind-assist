{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blindassist.local/schemas/p0_output_schema.json",
  "title": "BlindAssist P0 Grounding System Output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "episode_id",
    "provider_runs",
    "evidence",
    "candidates",
    "decision"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "episode_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "provider_runs": {
      "type": "array",
      "items": {"$ref": "#/$defs/providerRun"}
    },
    "evidence": {
      "type": "array",
      "items": {"$ref": "#/$defs/evidence"}
    },
    "candidates": {
      "type": "array",
      "items": {"$ref": "#/$defs/candidate"}
    },
    "decision": {"$ref": "#/$defs/decision"}
  },
  "$defs": {
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frame_id", "coordinate_space", "x_min", "y_min", "x_max", "y_max"],
      "properties": {
        "frame_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "coordinate_space": {"const": "NORMALIZED_XYXY"},
        "x_min": {"type": "number", "minimum": 0, "maximum": 1},
        "y_min": {"type": "number", "minimum": 0, "maximum": 1},
        "x_max": {"type": "number", "minimum": 0, "maximum": 1},
        "y_max": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "providerRun": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider_id", "status", "source_frame_ids", "evidence_ids", "candidate_ids", "failure_reason"],
      "properties": {
        "provider_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "status": {"enum": ["RUN_SUCCESS", "NOT_RUN", "RUN_FAILED", "INVALID_OUTPUT"]},
        "source_frame_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 128}
        },
        "evidence_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 128}
        },
        "candidate_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 128}
        },
        "failure_reason": {
          "oneOf": [
            {"type": "string", "minLength": 1, "maxLength": 512},
            {"type": "null"}
          ]
        }
      }
    },
    "identityClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_name", "relation"],
      "properties": {
        "target_name": {"type": ["string", "null"], "maxLength": 256},
        "relation": {"enum": ["entrance_of", "none"]}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["implementation_id", "config_id", "source_kind"],
      "properties": {
        "implementation_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "config_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "source_kind": {"enum": ["MOCK", "RGB_PROVIDER", "OCR_PROVIDER", "VLM_PROVIDER", "MAP_PRIOR"]}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_id",
        "evidence_id",
        "evidence_type",
        "source_frame_id",
        "source_timestamp_ms",
        "region_in_source_frame",
        "confidence",
        "validity",
        "expiry_timestamp_ms",
        "identity_claim",
        "provenance"
      ],
      "properties": {
        "provider_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "evidence_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "evidence_type": {
          "enum": ["ENTRANCE_STRUCTURE", "OPEN_VOCAB", "OCR_TEXT", "LOGO", "FACADE_RELATION", "POI_PRIOR"]
        },
        "source_frame_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "source_timestamp_ms": {"type": "integer", "minimum": 0},
        "region_in_source_frame": {
          "oneOf": [
            {"$ref": "#/$defs/region"},
            {"type": "null"}
          ]
        },
        "confidence": {
          "oneOf": [
            {"type": "number", "minimum": 0, "maximum": 1},
            {"type": "null"}
          ]
        },
        "validity": {"enum": ["VALID", "EXPIRED", "INVALID", "UNKNOWN"]},
        "expiry_timestamp_ms": {
          "oneOf": [
            {"type": "integer", "minimum": 0},
            {"type": "null"}
          ]
        },
        "identity_claim": {"$ref": "#/$defs/identityClaim"},
        "provenance": {"$ref": "#/$defs/provenance"}
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "region",
        "category_label",
        "identity_hypothesis",
        "confidence",
        "provider_rank",
        "provider_ids",
        "evidence_ids"
      ],
      "properties": {
        "candidate_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "region": {"$ref": "#/$defs/region"},
        "category_label": {"type": "string", "minLength": 1, "maxLength": 256},
        "identity_hypothesis": {"type": ["string", "null"], "maxLength": 256},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "provider_rank": {"type": "integer", "minimum": 1},
        "provider_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 128}
        },
        "evidence_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 128}
        }
      }
    },
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["handoff_id", "candidate_id", "source_frame_id", "spatial_region", "evidence_ids"],
      "properties": {
        "handoff_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "candidate_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "source_frame_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "spatial_region": {"$ref": "#/$defs/region"},
        "evidence_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 128}
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "selected_candidate_id",
        "ranked_candidate_ids",
        "source_frame_id",
        "decision_timestamp_ms",
        "spatial_region",
        "goal_identity_support",
        "spatial_support",
        "confidence",
        "supporting_evidence_ids",
        "competing_candidate_ids",
        "abstention_reason",
        "persistence_handoff_token"
      ],
      "properties": {
        "status": {"enum": ["GROUNDED", "AMBIGUOUS", "ABSTAIN_NO_RELIABLE_EVIDENCE", "INVALID_OBSERVATION"]},
        "selected_candidate_id": {"type": ["string", "null"], "maxLength": 128},
        "ranked_candidate_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 128}
        },
        "source_frame_id": {"type": ["string", "null"], "maxLength": 128},
        "decision_timestamp_ms": {"type": "integer", "minimum": 0},
        "spatial_region": {
          "oneOf": [
            {"$ref": "#/$defs/region"},
            {"type": "null"}
          ]
        },
        "goal_identity_support": {"enum": ["SUPPORTED", "INSUFFICIENT", "CONTRADICTED", "NOT_EVALUABLE"]},
        "spatial_support": {"enum": ["SUPPORTED", "INSUFFICIENT", "CONTRADICTED", "NOT_EVALUABLE"]},
        "confidence": {
          "oneOf": [
            {"type": "number", "minimum": 0, "maximum": 1},
            {"type": "null"}
          ]
        },
        "supporting_evidence_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 128}
        },
        "competing_candidate_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 128}
        },
        "abstention_reason": {
          "type": ["string", "null"],
          "enum": [
            null,
            "TARGET_NOT_VISIBLE",
            "NO_CANDIDATE",
            "AMBIGUOUS_CANDIDATES",
            "INSUFFICIENT_IDENTITY_EVIDENCE",
            "INSUFFICIENT_SPATIAL_EVIDENCE",
            "STALE_EVIDENCE",
            "INVALID_INPUT"
          ]
        },
        "persistence_handoff_token": {
          "oneOf": [
            {"$ref": "#/$defs/handoff"},
            {"type": "null"}
          ]
        }
      }
    }
  }
}
