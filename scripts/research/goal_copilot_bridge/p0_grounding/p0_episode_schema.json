{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blindassist.local/schemas/p0_episode_schema.json",
  "title": "BlindAssist P0 Named Building Entrance Grounding Episode",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "episode_id",
    "goal_spec",
    "observation_window",
    "observation_valid",
    "goal_reference_resolution",
    "target_visible",
    "valid_target_instances",
    "acceptable_spatial_regions",
    "distractor_instances",
    "target_min_side_px",
    "visibility_fraction",
    "text_support",
    "scene_condition",
    "grounding_expectation"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "episode_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "goal_spec": {"$ref": "#/$defs/goalSpec"},
    "observation_window": {"$ref": "#/$defs/observationWindow"},
    "observation_valid": {"type": "boolean"},
    "goal_reference_resolution": {"enum": ["UNIQUE", "SET_VALUED", "AMBIGUOUS"]},
    "target_visible": {"type": "boolean"},
    "valid_target_instances": {
      "type": "array",
      "items": {"$ref": "#/$defs/targetAnnotation"}
    },
    "acceptable_spatial_regions": {
      "type": "array",
      "items": {"$ref": "#/$defs/region"},
      "uniqueItems": true
    },
    "distractor_instances": {
      "type": "array",
      "items": {"$ref": "#/$defs/distractor"},
      "uniqueItems": true
    },
    "target_min_side_px": {
      "oneOf": [
        {"type": "number", "exclusiveMinimum": 0},
        {"type": "null"}
      ]
    },
    "visibility_fraction": {
      "oneOf": [
        {"type": "number", "minimum": 0, "maximum": 1},
        {"type": "null"}
      ]
    },
    "text_support": {
      "enum": ["READABLE", "PARTIAL", "NONE", "NOT_APPLICABLE"]
    },
    "scene_condition": {"$ref": "#/$defs/sceneCondition"},
    "grounding_expectation": {
      "enum": ["MUST_GROUND", "MUST_BE_AMBIGUOUS", "MUST_ABSTAIN", "INVALID_OBSERVATION"]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"goal_reference_resolution": {"const": "UNIQUE"}}, "required": ["goal_reference_resolution"]},
      "then": {
        "properties": {
          "valid_target_instances": {"minItems": 1, "maxItems": 1}
        }
      }
    },
    {
      "if": {"properties": {"goal_reference_resolution": {"const": "SET_VALUED"}}, "required": ["goal_reference_resolution"]},
      "then": {
        "properties": {
          "valid_target_instances": {"minItems": 2}
        }
      }
    },
    {
      "if": {"properties": {"goal_reference_resolution": {"const": "AMBIGUOUS"}}, "required": ["goal_reference_resolution"]},
      "then": {
        "properties": {
          "valid_target_instances": {"maxItems": 0},
          "target_visible": {"const": false},
          "acceptable_spatial_regions": {"maxItems": 0},
          "target_min_side_px": {"type": "null"},
          "visibility_fraction": {"type": "null"},
          "grounding_expectation": {"const": "MUST_BE_AMBIGUOUS"}
        }
      }
    },
    {
      "if": {"properties": {"target_visible": {"const": true}}, "required": ["target_visible"]},
      "then": {
        "properties": {
          "acceptable_spatial_regions": {"minItems": 1},
          "target_min_side_px": {"type": "number", "exclusiveMinimum": 0},
          "visibility_fraction": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    },
    {
      "if": {"properties": {"target_visible": {"const": false}}, "required": ["target_visible"]},
      "then": {
        "properties": {
          "acceptable_spatial_regions": {"maxItems": 0},
          "target_min_side_px": {"type": "null"},
          "visibility_fraction": {"type": "null"}
        }
      }
    },
    {
      "if": {"properties": {"observation_valid": {"const": false}}, "required": ["observation_valid"]},
      "then": {"properties": {"grounding_expectation": {"const": "INVALID_OBSERVATION"}}}
    }
  ],
  "$defs": {
    "goalSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["goal_type", "target_name", "requested_relation"],
      "properties": {
        "goal_type": {"const": "NAMED_BUILDING_ENTRANCE"},
        "target_name": {"type": "string", "minLength": 1, "maxLength": 256},
        "requested_relation": {"const": "entrance_of"}
      }
    },
    "observationWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frame_ids", "start_timestamp_ms", "end_timestamp_ms"],
      "properties": {
        "frame_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 128}
        },
        "start_timestamp_ms": {"type": "integer", "minimum": 0},
        "end_timestamp_ms": {"type": "integer", "minimum": 0}
      }
    },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frame_id", "coordinate_space", "x_min", "y_min", "x_max", "y_max"],
      "properties": {
        "frame_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "coordinate_space": {"const": "NORMALIZED_XYXY"},
        "x_min": {"type": "number", "minimum": 0, "maximum": 1},
        "y_min": {"type": "number", "minimum": 0, "maximum": 1},
        "x_max": {"type": "number", "minimum": 0, "maximum": 1},
        "y_max": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "targetAnnotation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_instance_id", "target_name", "relation", "regions"],
      "properties": {
        "target_instance_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "target_name": {"type": "string", "minLength": 1, "maxLength": 256},
        "relation": {"const": "entrance_of"},
        "regions": {"type": "array", "items": {"$ref": "#/$defs/region"}}
      }
    },
    "distractor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["distractor_instance_id", "semantic_role", "region"],
      "properties": {
        "distractor_instance_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "semantic_role": {
          "enum": ["OTHER_BUILDING_ENTRANCE", "NON_ENTRANCE_DOOR", "SAME_BUILDING_NON_TARGET_ENTRANCE"]
        },
        "region": {"$ref": "#/$defs/region"}
      }
    },
    "sceneCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_size",
        "visibility",
        "entrance_count",
        "same_class_distractor",
        "illumination",
        "view_angle"
      ],
      "properties": {
        "target_size": {"enum": ["TINY", "SMALL", "MEDIUM", "LARGE", "ABSENT"]},
        "visibility": {"enum": ["FULL", "PARTIAL", "HEAVY_OCCLUSION", "ABSENT"]},
        "entrance_count": {"enum": ["SINGLE", "MULTIPLE"]},
        "same_class_distractor": {"type": "boolean"},
        "illumination": {"enum": ["DAYLIGHT", "LOW_LIGHT", "GLARE", "MIXED"]},
        "view_angle": {"enum": ["FRONTAL", "OBLIQUE", "MIXED"]}
      }
    }
  }
}
