{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blindassist.local/schemas/p1-target-persistence-output-v1.json",
  "title": "BlindAssist P1-R0 system output",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "protocol_id", "episode_id", "referent_id", "score_semantics", "frames"],
  "properties": {
    "schema_version": {"const": 1},
    "protocol_id": {"const": "BA-P1-TARGET-PERSISTENCE-R0-V1"},
    "episode_id": {"type": "string", "minLength": 1},
    "referent_id": {"type": ["string", "null"]},
    "score_semantics": {"const": "ALGORITHMIC_EVIDENCE_NOT_CALIBRATED_PROBABILITY"},
    "frames": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "frame_index", "state", "current_candidate_id", "identity_score", "stability_score",
          "oscillation_score", "frames_since_confirmed", "event"
        ],
        "properties": {
          "frame_index": {"type": "integer", "minimum": 0},
          "state": {"enum": ["UNBOUND", "TRACKING", "UNCERTAIN", "TEMP_UNOBSERVABLE", "LOST"]},
          "current_candidate_id": {"type": ["string", "null"]},
          "identity_score": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
          "stability_score": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
          "oscillation_score": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
          "frames_since_confirmed": {"type": ["integer", "null"], "minimum": 0},
          "event": {"enum": ["NONE", "TARGET_TEMP_UNOBSERVABLE", "LOSS_DETECTED", "REACQUIRED", "REGROUND_REQUIRED"]}
        }
      }
    }
  }
}
