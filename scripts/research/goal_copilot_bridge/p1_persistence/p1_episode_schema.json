{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blindassist.local/schemas/p1-target-persistence-episode-v1.json",
  "title": "BlindAssist P1-R0 evaluator episode",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "protocol_id", "episode_id", "scenario_class", "handoff", "frames", "truth"],
  "properties": {
    "schema_version": {"const": 1},
    "protocol_id": {"const": "BA-P1-TARGET-PERSISTENCE-R0-V1"},
    "episode_id": {"type": "string", "minLength": 1},
    "scenario_class": {
      "enum": [
        "CONTINUOUS_VISIBLE_CAMERA_MOTION",
        "SHORT_OCCLUSION",
        "TURN_AWAY_AND_RETURN",
        "SAME_CLASS_DISTRACTOR_CROSSING",
        "SIMILAR_CANDIDATE_ALTERNATION",
        "LONG_TARGET_ABSENCE",
        "FALSE_SIMILAR_AFTER_LOSS",
        "NO_REFERENT_GUARD"
      ]
    },
    "handoff": {"$ref": "#/$defs/handoff"},
    "frames": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/frame"}},
    "truth": {"$ref": "#/$defs/truth"}
  },
  "$defs": {
    "score": {"type": "number", "minimum": 0, "maximum": 1},
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "goal_id", "referent_id", "grounding_provenance"],
      "properties": {
        "status": {"enum": ["REFERENT_ESTABLISHED", "NO_REFERENT"]},
        "goal_id": {"type": "string", "minLength": 1},
        "referent_id": {"type": ["string", "null"]},
        "grounding_provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["p0_decision_id", "source_frame_index", "authority"],
          "properties": {
            "p0_decision_id": {"type": ["string", "null"]},
            "source_frame_index": {"type": ["integer", "null"], "minimum": 0},
            "authority": {"enum": ["P0_ESTABLISHED_REFERENT", "P0_NO_REFERENT"]}
          }
        }
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "REFERENT_ESTABLISHED"}}},
          "then": {
            "properties": {
              "referent_id": {"type": "string", "minLength": 1},
              "grounding_provenance": {
                "properties": {
                  "p0_decision_id": {"type": "string", "minLength": 1},
                  "source_frame_index": {"type": "integer", "minimum": 0},
                  "authority": {"const": "P0_ESTABLISHED_REFERENT"}
                }
              }
            }
          },
          "else": {
            "properties": {
              "referent_id": {"type": "null"},
              "grounding_provenance": {
                "properties": {
                  "p0_decision_id": {"type": "null"},
                  "source_frame_index": {"type": "null"},
                  "authority": {"const": "P0_NO_REFERENT"}
                }
              }
            }
          }
        }
      ]
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "identity_support", "identity_contradiction", "stability", "oscillation"],
      "properties": {
        "candidate_id": {"type": "string", "minLength": 1},
        "identity_support": {"$ref": "#/$defs/score"},
        "identity_contradiction": {"$ref": "#/$defs/score"},
        "stability": {"$ref": "#/$defs/score"},
        "oscillation": {"$ref": "#/$defs/score"}
      }
    },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frame_index", "timestamp_ms", "candidates"],
      "properties": {
        "frame_index": {"type": "integer", "minimum": 0},
        "timestamp_ms": {"type": "integer", "minimum": 0},
        "candidates": {"type": "array", "items": {"$ref": "#/$defs/candidate"}}
      }
    },
    "truth_frame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frame_index", "referent_observable", "candidate_instance_map", "allowed_states", "allowed_events", "phase"],
      "properties": {
        "frame_index": {"type": "integer", "minimum": 0},
        "referent_observable": {"type": "boolean"},
        "candidate_instance_map": {
          "type": "object",
          "additionalProperties": {"type": "string", "minLength": 1}
        },
        "allowed_states": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["UNBOUND", "TRACKING", "UNCERTAIN", "TEMP_UNOBSERVABLE", "LOST"]}
        },
        "allowed_events": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["NONE", "TARGET_TEMP_UNOBSERVABLE", "LOSS_DETECTED", "REACQUIRED", "REGROUND_REQUIRED"]}
        },
        "phase": {"enum": ["VISIBLE", "SHORT_UNOBSERVABLE", "LOSS_ELIGIBLE", "REACQUISITION_WINDOW"]}
      }
    },
    "truth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["referent_instance_id", "frames"],
      "properties": {
        "referent_instance_id": {"type": ["string", "null"]},
        "frames": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/truth_frame"}}
      }
    }
  }
}
