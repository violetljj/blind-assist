{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blindassist.local/schemas/p1-target-persistence-public-input-v1.json",
  "title": "BlindAssist P1-R0 system-visible input",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "protocol_id", "episode_id", "handoff", "frames"],
  "properties": {
    "schema_version": {"const": 1},
    "protocol_id": {"const": "BA-P1-TARGET-PERSISTENCE-R0-V1"},
    "episode_id": {"type": "string", "minLength": 1},
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "goal_id", "referent_id", "grounding_provenance"],
      "properties": {
        "status": {"enum": ["REFERENT_ESTABLISHED", "NO_REFERENT"]},
        "goal_id": {"type": "string", "minLength": 1},
        "referent_id": {"type": ["string", "null"]},
        "grounding_provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["p0_decision_id", "source_frame_index", "authority"],
          "properties": {
            "p0_decision_id": {"type": ["string", "null"]},
            "source_frame_index": {"type": ["integer", "null"], "minimum": 0},
            "authority": {"enum": ["P0_ESTABLISHED_REFERENT", "P0_NO_REFERENT"]}
          }
        }
      }
    },
    "frames": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["frame_index", "timestamp_ms", "candidates"],
        "properties": {
          "frame_index": {"type": "integer", "minimum": 0},
          "timestamp_ms": {"type": "integer", "minimum": 0},
          "candidates": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["candidate_id", "identity_support", "identity_contradiction", "stability", "oscillation"],
              "properties": {
                "candidate_id": {"type": "string", "minLength": 1},
                "identity_support": {"type": "number", "minimum": 0, "maximum": 1},
                "identity_contradiction": {"type": "number", "minimum": 0, "maximum": 1},
                "stability": {"type": "number", "minimum": 0, "maximum": 1},
                "oscillation": {"type": "number", "minimum": 0, "maximum": 1}
              }
            }
          }
        }
      }
    }
  }
}
