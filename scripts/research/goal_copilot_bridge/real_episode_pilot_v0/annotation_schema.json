{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "teacher_output": {
      "additionalProperties": false,
      "properties": {
        "implementation_id": {"type": ["string", "null"]},
        "independent_of_evaluated_provider": {"type": ["boolean", "null"]},
        "provider_family_overlap": {"type": ["boolean", "null"]},
        "raw_output": {},
        "status": {"enum": ["NOT_RUN", "RUN_SUCCESS", "RUN_FAILED"]},
        "teacher_id": {"minLength": 1, "type": "string"}
      },
      "required": ["teacher_id", "implementation_id", "status", "raw_output", "independent_of_evaluated_provider", "provider_family_overlap"],
      "type": "object"
    },
    "observation": {
      "properties": {
        "allowed_decision_states": {"items": {"type": "string"}, "type": "array"},
        "functional_authority": {"enum": ["ESTABLISHED", "NOT_ESTABLISHED"]},
        "functional_authority_sources": {"items": {"type": "string"}, "type": "array"},
        "handoff_truth": {"type": "boolean"},
        "legal_candidate_ids": {"items": {"type": "string"}, "type": "array"},
        "legal_regions_normalized_xyxy": {
          "items": {
            "items": {"maximum": 1.0, "minimum": 0.0, "type": "number"},
            "maxItems": 4,
            "minItems": 4,
            "type": "array"
          },
          "type": "array"
        },
        "notes": {"type": "string"},
        "observation_id": {"minLength": 1, "type": "string"},
        "range_truth": {"enum": ["RANGE_FAR", "RANGE_APPROACHING", "RANGE_NEAR", "RANGE_UNKNOWN"]},
        "target_visibility": {"enum": ["VISIBLE", "NOT_VISIBLE", "UNKNOWN"]},
        "teacher_agreement": {"enum": ["AGREE", "PARTIAL", "DISAGREE", null]},
        "teacher_outputs": {
          "additionalProperties": false,
          "properties": {
            "teacher_A": {"$ref": "#/$defs/teacher_output"},
            "teacher_B": {"$ref": "#/$defs/teacher_output"},
            "teacher_C": {"$ref": "#/$defs/teacher_output"}
          },
          "required": ["teacher_A", "teacher_B", "teacher_C"],
          "type": "object"
        },
        "truth_authority_tier": {"enum": ["NATIVE_GT", "MAP_TRAJECTORY_DERIVED", "TEACHER_SUPPORTED", "TEACHER_ONLY_WEAK", "UNKNOWN"]},
        "user_confirmed": {"type": "boolean"},
        "user_denied": {"type": "boolean"}
      },
      "required": ["observation_id", "truth_authority_tier", "teacher_outputs", "teacher_agreement", "functional_authority", "functional_authority_sources", "target_visibility", "legal_candidate_ids", "legal_regions_normalized_xyxy", "allowed_decision_states", "range_truth", "user_confirmed", "user_denied", "handoff_truth", "notes"],
      "type": "object"
    }
  },
  "properties": {
    "episodes": {
      "items": {
        "properties": {
          "episode_id": {"minLength": 1, "type": "string"},
          "observations": {"items": {"$ref": "#/$defs/observation"}, "minItems": 1, "type": "array"}
        },
        "required": ["episode_id", "observations"],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "private_evaluator_only": {"const": true},
    "public_manifest_schema": {"const": "blindassist_real_episode_public_manifest_v0"},
    "schema_version": {"const": "blindassist_real_episode_annotation_v1"},
    "truth_frozen": {"type": "boolean"}
  },
  "required": ["schema_version", "private_evaluator_only", "truth_frozen", "public_manifest_schema", "episodes"],
  "type": "object"
}
