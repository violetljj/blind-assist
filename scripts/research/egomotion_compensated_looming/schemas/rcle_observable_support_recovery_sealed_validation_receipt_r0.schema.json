{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rcle.observable_support_recovery.sealed_validation_receipt.r0",
  "title": "RCLE Observable Support Recovery R0 Sealed Validation Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate_id",
    "design_lock_sha256",
    "candidate_lock_sha256",
    "development_receipt_sha256",
    "protocol_sha256",
    "validation_lock_sha256",
    "started_at",
    "finished_at",
    "command",
    "worker_count",
    "repo",
    "environment",
    "candidate_source_manifest",
    "output_manifest",
    "scientific_summary_sha256",
    "scientific_gate_pass",
    "terminal_state",
    "authority",
    "recompute_command"
  ],
  "properties": {
    "schema_version": {
      "const": "rcle.observable_support_recovery.sealed_validation_receipt.v1"
    },
    "candidate_id": {
      "const": "OBSERVABLE_THREE_FRAME_SUPPORT_MANAGER_R0"
    },
    "design_lock_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "candidate_lock_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "development_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "protocol_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "validation_lock_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "started_at": {"type": "string"},
    "finished_at": {"type": "string"},
    "command": {"type": "array", "items": {"type": "string"}},
    "worker_count": {"type": "integer", "minimum": 1},
    "repo": {"type": "object"},
    "environment": {"type": "object"},
    "candidate_source_manifest": {
      "type": "object",
      "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    },
    "output_manifest": {
      "type": "object",
      "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    },
    "scientific_summary_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "scientific_gate_pass": {"type": "boolean"},
    "terminal_state": {
      "enum": [
        "INDEPENDENT_SYNTHETIC_PASS_ONLY_PHASE_B_REMAINS_CLOSED_PENDING_SEPARATE_DECISION",
        "CLOSE_OBSERVABLE_THREE_FRAME_SUPPORT_MANAGER_R0_WITH_NO_PATCH_OR_RERUN"
      ]
    },
    "authority": {"const": "INDEPENDENT_SYNTHETIC_VALIDATION_EVIDENCE_ONLY"},
    "recompute_command": {"type": "array", "items": {"type": "string"}}
  }
}
