{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rcle_phase_b_bonn_b1a_receipt.schema.json",
  "title": "RCLE Phase B Bonn B1A receipt",
  "type": "object",
  "required": [
    "schema_version",
    "protocol_id",
    "created_at",
    "environment",
    "design_lock_sha256",
    "preregistration_sha256",
    "implementation_lock_sha256",
    "bootstrap_runner_sha256",
    "b0_receipt_sha256",
    "window_denominator_sha256",
    "cohort_identity_sha256",
    "source_authority_sha256_by_id",
    "archive_sha256_by_sequence",
    "run_claim_sha256",
    "claim",
    "read_firewall",
    "ledger_identity_sha256",
    "ledger",
    "branch_distinct_sequence_counts",
    "gate_pass",
    "terminal_state",
    "b1b_branch_scope_may_be_reviewed",
    "execution_authority_consumed",
    "b1b_implementation_authorized"
  ],
  "properties": {
    "schema_version": {
      "const": "rcle.phase_b.bonn.b1a.receipt.v1"
    },
    "protocol_id": {
      "const": "RCLE_PHASE_B_BONN_B1A_SOURCE_NATIVE_GEOMETRY_ADMISSION"
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "environment": {
      "type": "object",
      "required": [
        "python",
        "numpy",
        "pillow"
      ],
      "properties": {
        "python": {
          "const": "3.11.9"
        },
        "numpy": {
          "const": "2.1.3"
        },
        "pillow": {
          "const": "12.2.0"
        }
      },
      "additionalProperties": false
    },
    "design_lock_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "preregistration_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "implementation_lock_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "bootstrap_runner_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "b0_receipt_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "window_denominator_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "cohort_identity_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "source_authority_sha256_by_id": {
      "type": "object",
      "required": [
        "bonn_official_page",
        "tum_file_formats"
      ],
      "properties": {
        "bonn_official_page": {
          "$ref": "#/$defs/sha256"
        },
        "tum_file_formats": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "archive_sha256_by_sequence": {
      "type": "object",
      "minProperties": 6,
      "maxProperties": 6,
      "additionalProperties": {
        "$ref": "#/$defs/sha256"
      }
    },
    "run_claim_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "claim": {
      "type": "object",
      "required": [
        "exclusive_create",
        "maximum_claims",
        "application_data_operations_before_claim",
        "claim_permanently_retained"
      ],
      "properties": {
        "exclusive_create": {
          "const": true
        },
        "maximum_claims": {
          "const": 1
        },
        "application_data_operations_before_claim": {
          "const": 0
        },
        "claim_permanently_retained": {
          "const": true
        }
      },
      "additionalProperties": true
    },
    "read_firewall": {
      "type": "object",
      "required": [
        "rgb_member_bytes_read",
        "rgb_decode_operations",
        "phase_b_metric_operations",
        "static_map_reads",
        "legacy_bonn_outcome_reads",
        "network_operations"
      ],
      "properties": {
        "rgb_member_bytes_read": {
          "const": 0
        },
        "rgb_decode_operations": {
          "const": 0
        },
        "phase_b_metric_operations": {
          "const": 0
        },
        "static_map_reads": {
          "const": 0
        },
        "legacy_bonn_outcome_reads": {
          "const": 0
        },
        "network_operations": {
          "const": 0
        }
      },
      "additionalProperties": true
    },
    "ledger_identity_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "ledger": {
      "$ref": "#/$defs/ledger"
    },
    "branch_distinct_sequence_counts": {
      "type": "object",
      "required": [
        "ROTATION_TRUTH_ELIGIBLE",
        "STATIC_APPROACH_TRUTH_ELIGIBLE"
      ],
      "properties": {
        "ROTATION_TRUTH_ELIGIBLE": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6
        },
        "STATIC_APPROACH_TRUTH_ELIGIBLE": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6
        }
      },
      "additionalProperties": false
    },
    "gate_pass": {
      "type": "boolean"
    },
    "terminal_state": {
      "enum": [
        "B1A_SOURCE_NATIVE_GEOMETRY_ADMISSION_VALID_B1B_BRANCH_SCOPE_MAY_BE_REVIEWED",
        "HOLD_B1_SOURCE_NATIVE_TRUTH_NOT_EVALUABLE_NO_WINDOW_REPLACEMENT",
        "INVALID_EXECUTION_CLOSE_B1"
      ]
    },
    "b1b_branch_scope_may_be_reviewed": {
      "type": "boolean"
    },
    "execution_authority_consumed": {
      "const": true
    },
    "b1b_implementation_authorized": {
      "const": false
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "canonicalWindow": {
      "type": "object",
      "required": [
        "sequence_rank",
        "sequence_id",
        "window_rank",
        "start",
        "end"
      ],
      "properties": {
        "sequence_rank": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        },
        "sequence_id": {
          "type": "string",
          "minLength": 1
        },
        "window_rank": {
          "type": "integer",
          "minimum": 0
        },
        "start": {
          "type": "string",
          "pattern": "^[0-9]+(?:\\.[0-9]+)?$"
        },
        "end": {
          "type": "string",
          "pattern": "^[0-9]+(?:\\.[0-9]+)?$"
        }
      },
      "additionalProperties": false
    },
    "grid": {
      "type": "object",
      "required": [
        "grid_index",
        "N_previous",
        "N_projected",
        "N_observed",
        "N_static",
        "truth_eligible",
        "c_truth_grid_hex"
      ],
      "properties": {
        "grid_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        },
        "N_previous": {
          "type": "integer",
          "minimum": 0
        },
        "N_projected": {
          "type": "integer",
          "minimum": 0
        },
        "N_observed": {
          "type": "integer",
          "minimum": 0
        },
        "N_static": {
          "type": "integer",
          "minimum": 0
        },
        "truth_eligible": {
          "type": "boolean"
        },
        "c_truth_grid_hex": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^-?0x[0-9a-f]+(?:\\.[0-9a-f]+)?p[+-][0-9]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "abstention_reason": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": true
    },
    "pair": {
      "type": "object",
      "required": [
        "sequence_id",
        "window_rank",
        "previous_rgb_source_row_rank",
        "current_rgb_source_row_rank",
        "dt",
        "candidate",
        "grids"
      ],
      "properties": {
        "sequence_id": {
          "type": "string",
          "minLength": 1
        },
        "window_rank": {
          "type": "integer",
          "minimum": 0
        },
        "previous_rgb_source_row_rank": {
          "type": "integer",
          "minimum": 0
        },
        "current_rgb_source_row_rank": {
          "type": "integer",
          "minimum": 0
        },
        "dt": {
          "type": "string",
          "pattern": "^[0-9]+(?:\\.[0-9]+)?$"
        },
        "candidate": {
          "type": "boolean"
        },
        "grids": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "items": {
            "$ref": "#/$defs/grid"
          }
        }
      },
      "additionalProperties": true
    },
    "windowResult": {
      "type": "object",
      "required": [
        "sequence_id",
        "window_rank",
        "candidate_pair_denominator_count",
        "truth_covered_pair_count",
        "role"
      ],
      "properties": {
        "sequence_id": {
          "type": "string"
        },
        "window_rank": {
          "type": "integer",
          "minimum": 0
        },
        "candidate_pair_denominator_count": {
          "type": "integer",
          "minimum": 0
        },
        "truth_covered_pair_count": {
          "type": "integer",
          "minimum": 0
        },
        "role": {
          "enum": [
            "ROTATION_TRUTH_ELIGIBLE",
            "STATIC_APPROACH_TRUTH_ELIGIBLE",
            "NOT_EVALUABLE_NO_FROZEN_PHASE_B_CONDITION",
            "NOT_EVALUABLE_SOURCE_NATIVE_TRUTH_COVERAGE"
          ]
        }
      },
      "additionalProperties": true
    },
    "ledger": {
      "type": "object",
      "required": [
        "schema_version",
        "windows",
        "pairs",
        "window_results"
      ],
      "properties": {
        "schema_version": {
          "const": "rcle.phase_b.bonn_b1a.ledger.v1"
        },
        "windows": {
          "type": "array",
          "minItems": 10,
          "maxItems": 10,
          "items": {
            "$ref": "#/$defs/canonicalWindow"
          }
        },
        "pairs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pair"
          }
        },
        "window_results": {
          "type": "array",
          "minItems": 10,
          "maxItems": 10,
          "items": {
            "$ref": "#/$defs/windowResult"
          }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
