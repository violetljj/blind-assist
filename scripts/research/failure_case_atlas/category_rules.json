{
  "schema_version": "blindassist.failure_case_atlas.category_rules.v1",
  "description": "Evidence-bound category rules for the visual-only Failure Case Atlas.",
  "default_category": "other",
  "categories": [
    {
      "slug": "miss",
      "label": "漏检",
      "rules": [
        {
          "type": "mask_relation",
          "relation": "residual_truth_not_covered",
          "evidence": "residual truth pixels not covered by candidate mask"
        }
      ]
    },
    {
      "slug": "false_positive",
      "label": "误检",
      "rules": [
        {
          "type": "component_flag_or_mask_relation",
          "field": "false_activation",
          "relation": "prediction_outside_residual_truth",
          "evidence": "atlas false_activation or candidate pixels outside residual truth"
        }
      ]
    },
    {
      "slug": "late_alert",
      "label": "晚提醒",
      "no_match_reason_without_event_ledger": "no event/appearance ledger supplied; current Atlas does not establish this category",
      "rules": [
        {
          "type": "event_bool_any",
          "fields": [
            "late_alert",
            "late",
            "late_reminder"
          ],
          "evidence": "event ledger late flag/delay"
        },
        {
          "type": "event_number_positive",
          "field": "alert_delay_frames",
          "evidence": "event ledger late flag/delay"
        },
        {
          "type": "event_token",
          "tokens": [
            "late_alert",
            "late reminder",
            "晚提醒"
          ],
          "evidence": "event ledger late flag/delay"
        }
      ]
    },
    {
      "slug": "uncleared_alert",
      "label": "提醒无法清除",
      "no_match_reason_without_event_ledger": "no event/appearance ledger supplied; current Atlas does not establish this category",
      "rules": [
        {
          "type": "event_bool_any",
          "fields": [
            "uncleared_alert",
            "unable_to_clear",
            "not_cleared"
          ],
          "evidence": "event ledger clearance status"
        },
        {
          "type": "event_field_token",
          "fields": [
            "clearance_status",
            "clear_status"
          ],
          "tokens": [
            "unclear",
            "unable",
            "not_cleared",
            "无法清除"
          ],
          "evidence": "event ledger clearance status"
        },
        {
          "type": "event_token",
          "tokens": [
            "uncleared",
            "unable_to_clear",
            "提醒无法清除"
          ],
          "evidence": "event ledger clearance status"
        }
      ]
    },
    {
      "slug": "upper_field",
      "label": "上部视场误激活",
      "rules": [
        {
          "type": "component_tag",
          "tag": "UPPER_FIELD_BACKGROUND_ACTIVATION_PROXY",
          "evidence": "atlas mechanism tag UPPER_FIELD_BACKGROUND_ACTIVATION_PROXY"
        }
      ]
    },
    {
      "slug": "small_fragment",
      "label": "小碎片",
      "rules": [
        {
          "type": "component_tag",
          "tag": "SMALL_FRAGMENT_NOISE",
          "evidence": "atlas mechanism tag SMALL_FRAGMENT_NOISE"
        }
      ]
    },
    {
      "slug": "stable_high_confidence",
      "label": "稳定高置信错误",
      "rules": [
        {
          "type": "component_tag",
          "tag": "STABLE_HIGH_CONFIDENCE_ERROR",
          "evidence": "atlas mechanism tag STABLE_HIGH_CONFIDENCE_ERROR"
        }
      ]
    },
    {
      "slug": "temporal_flicker",
      "label": "temporal flicker",
      "rules": [
        {
          "type": "component_tag",
          "tag": "TEMPORAL_FLICKER",
          "evidence": "atlas mechanism tag TEMPORAL_FLICKER"
        }
      ]
    },
    {
      "slug": "boundary_dilation",
      "label": "boundary dilation",
      "rules": [
        {
          "type": "component_tag",
          "tag": "BOUNDARY_DILATION",
          "evidence": "atlas mechanism tag BOUNDARY_DILATION"
        }
      ]
    },
    {
      "slug": "yolo_attribution",
      "label": "YOLO attribution ambiguity",
      "rules": [
        {
          "type": "component_tag",
          "tag": "YOLO_ATTRIBUTION_AMBIGUITY",
          "evidence": "atlas mechanism tag YOLO_ATTRIBUTION_AMBIGUITY"
        }
      ]
    },
    {
      "slug": "parallel_curb",
      "label": "parallel curb",
      "rules": [
        {
          "type": "bucket_or_event_token",
          "bucket_tokens": [
            "parallel_boundary"
          ],
          "event_tokens": [
            "parallel_curb",
            "parallel boundary"
          ],
          "evidence": "scene_bucket/event ledger"
        }
      ]
    },
    {
      "slug": "shadow_texture",
      "label": "shadow/texture",
      "no_match_reason_without_event_ledger": "no event/appearance ledger supplied; current Atlas does not establish this category",
      "rules": [
        {
          "type": "explicit_appearance_token",
          "component_fields": [
            "texture_or_shadow_confusion_status"
          ],
          "include_event_values": true,
          "tokens": [
            "shadow",
            "texture",
            "阴影",
            "纹理"
          ],
          "blocked_tokens": [
            "not_evaluable",
            "absent",
            "unknown"
          ],
          "evidence": "explicit upstream appearance label"
        }
      ]
    },
    {
      "slug": "pedestrian_crossing",
      "label": "行人横穿",
      "rules": [
        {
          "type": "bucket_or_event_token",
          "bucket_tokens": [
            "pedestrian",
            "lateral_pedestrian",
            "ebike"
          ],
          "event_tokens": [
            "pedestrian",
            "crossing",
            "person_stream",
            "横穿"
          ],
          "evidence": "scene_bucket/event ledger"
        }
      ]
    },
    {
      "slug": "stairs_level_change",
      "label": "台阶和落差",
      "rules": [
        {
          "type": "bucket_or_event_token",
          "bucket_tokens": [
            "step",
            "curb",
            "stair",
            "level"
          ],
          "event_tokens": [
            "step",
            "curb",
            "stair",
            "level_change",
            "台阶",
            "落差"
          ],
          "evidence": "scene_bucket/event ledger"
        }
      ]
    },
    {
      "slug": "other",
      "label": "其他/未归类",
      "rules": []
    }
  ]
}
