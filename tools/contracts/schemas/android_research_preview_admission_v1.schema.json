{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/violetljj/blind-assist/schemas/android_research_preview_admission_v1.schema.json",
  "title": "BlindAssist Android research-preview admission receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "contract",
    "observed",
    "evidence",
    "quality",
    "android_feasibility",
    "product_authority",
    "admission"
  ],
  "properties": {
    "schema_version": {
      "const": "blindassist_android_research_preview_admission_v1"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frozen_at",
        "candidate_id",
        "protocol",
        "thresholds",
        "roster",
        "identity",
        "supported_backend",
        "reference_runtime_sha256",
        "freeze_commit"
      ],
      "properties": {
        "frozen_at": {
          "type": "string",
          "format": "date-time"
        },
        "candidate_id": {
          "enum": [
            "DA2",
            "A2-392"
          ]
        },
        "protocol": {
          "$ref": "#/$defs/versionedBinding"
        },
        "thresholds": {
          "$ref": "#/$defs/thresholdBinding"
        },
        "roster": {
          "$ref": "#/$defs/rosterBinding"
        },
        "identity": {
          "$ref": "#/$defs/identity"
        },
        "supported_backend": {
          "type": "string",
          "minLength": 1
        },
        "reference_runtime_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "freeze_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "observed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "android"
      ],
      "properties": {
        "identity": {
          "$ref": "#/$defs/nullableIdentity"
        },
        "android": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "observed_backend",
            "fallback_observed",
            "fallback_backend",
            "reference_parity",
            "cold_start_ms",
            "warm_start_ms",
            "latency_p50_ms",
            "latency_p95_ms",
            "peak_memory_mb",
            "thermal_window_seconds",
            "requested_backend"
          ],
          "properties": {
            "observed_backend": {
              "type": [
                "string",
                "null"
              ]
            },
            "fallback_observed": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "fallback_backend": {
              "type": [
                "string",
                "null"
              ]
            },
            "reference_parity": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "runtime_sha256",
                "measured_max_abs_error"
              ],
              "properties": {
                "runtime_sha256": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/sha256"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "measured_max_abs_error": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/nonnegativeFiniteNumber"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            },
            "cold_start_ms": {
              "anyOf": [
                {
                  "$ref": "#/$defs/nonnegativeFiniteNumber"
                },
                {
                  "type": "null"
                }
              ]
            },
            "warm_start_ms": {
              "anyOf": [
                {
                  "$ref": "#/$defs/nonnegativeFiniteNumber"
                },
                {
                  "type": "null"
                }
              ]
            },
            "latency_p50_ms": {
              "anyOf": [
                {
                  "$ref": "#/$defs/nonnegativeFiniteNumber"
                },
                {
                  "type": "null"
                }
              ]
            },
            "latency_p95_ms": {
              "anyOf": [
                {
                  "$ref": "#/$defs/nonnegativeFiniteNumber"
                },
                {
                  "type": "null"
                }
              ]
            },
            "peak_memory_mb": {
              "anyOf": [
                {
                  "$ref": "#/$defs/nonnegativeFiniteNumber"
                },
                {
                  "type": "null"
                }
              ]
            },
            "thermal_window_seconds": {
              "anyOf": [
                {
                  "$ref": "#/$defs/nonnegativeFiniteNumber"
                },
                {
                  "type": "null"
                }
              ]
            },
            "requested_backend": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "complete",
        "opened_after_contract_freeze",
        "parent_session_disjoint",
        "parent_sessions",
        "pooled",
        "outcome_opened_at",
        "frozen_contract_sha256",
        "performance_sessions"
      ],
      "properties": {
        "complete": {
          "type": "boolean"
        },
        "opened_after_contract_freeze": {
          "type": "boolean"
        },
        "parent_session_disjoint": {
          "type": "boolean"
        },
        "parent_sessions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/parentSession"
          }
        },
        "pooled": {
          "$ref": "#/$defs/aggregate"
        },
        "outcome_opened_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "frozen_contract_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "performance_sessions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/performanceRecord"
          }
        }
      }
    },
    "quality": {
      "$ref": "#/$defs/subDecision"
    },
    "android_feasibility": {
      "$ref": "#/$defs/subDecision"
    },
    "product_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "authorized_scopes",
        "reason_codes"
      ],
      "properties": {
        "decision": {
          "const": "DENIED"
        },
        "authorized_scopes": {
          "type": "array",
          "maxItems": 0
        },
        "reason_codes": {
          "const": [
            "RESEARCH_PREVIEW_HAS_NO_PRODUCT_AUTHORITY"
          ]
        }
      }
    },
    "admission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "authorized_scope",
        "terminal",
        "rescue_allowed",
        "reason_codes"
      ],
      "properties": {
        "decision": {
          "enum": [
            "PASS",
            "FAIL",
            "UNKNOWN"
          ]
        },
        "authorized_scope": {
          "enum": [
            "ANDROID_RESEARCH_PREVIEW_ONLY",
            "NONE"
          ]
        },
        "terminal": {
          "const": true
        },
        "rescue_allowed": {
          "const": false
        },
        "reason_codes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "finiteNumber": {
      "type": "number"
    },
    "nonnegativeFiniteNumber": {
      "type": "number",
      "minimum": 0
    },
    "versionedBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "sha256"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "thresholdBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "sha256",
        "values"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "values": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "false_clear",
            "false_block",
            "known_coverage",
            "clearance_error",
            "transition_consistency",
            "max_reference_parity_error",
            "max_cold_start_ms",
            "max_warm_start_ms",
            "max_latency_p50_ms",
            "max_latency_p95_ms",
            "max_peak_memory_mb",
            "min_thermal_window_seconds"
          ],
          "properties": {
            "false_clear": {
              "$ref": "#/$defs/proportion"
            },
            "false_block": {
              "$ref": "#/$defs/proportion"
            },
            "known_coverage": {
              "$ref": "#/$defs/proportion"
            },
            "clearance_error": {
              "$ref": "#/$defs/nonnegativeFiniteNumber"
            },
            "transition_consistency": {
              "$ref": "#/$defs/proportion"
            },
            "max_reference_parity_error": {
              "$ref": "#/$defs/nonnegativeFiniteNumber"
            },
            "max_cold_start_ms": {
              "$ref": "#/$defs/nonnegativeFiniteNumber"
            },
            "max_warm_start_ms": {
              "$ref": "#/$defs/nonnegativeFiniteNumber"
            },
            "max_latency_p50_ms": {
              "$ref": "#/$defs/nonnegativeFiniteNumber"
            },
            "max_latency_p95_ms": {
              "$ref": "#/$defs/nonnegativeFiniteNumber"
            },
            "max_peak_memory_mb": {
              "$ref": "#/$defs/nonnegativeFiniteNumber"
            },
            "min_thermal_window_seconds": {
              "$ref": "#/$defs/nonnegativeFiniteNumber"
            }
          }
        }
      }
    },
    "rosterBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "sha256",
        "roles",
        "members"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "members": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/rosterEntry"
          }
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_sha256",
        "export_sha256",
        "preprocess_sha256",
        "postprocess_sha256",
        "input_manifest_sha256",
        "input_shape",
        "state_reset_sha256"
      ],
      "properties": {
        "model_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "export_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "preprocess_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "postprocess_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "input_manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "input_shape": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "state_reset_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "nullableIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_sha256",
        "export_sha256",
        "preprocess_sha256",
        "postprocess_sha256",
        "input_manifest_sha256",
        "input_shape",
        "state_reset_sha256"
      ],
      "properties": {
        "model_sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "export_sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "preprocess_sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "postprocess_sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "input_manifest_sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "input_shape": {
          "anyOf": [
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "integer",
                "minimum": 1
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "state_reset_sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "qualityMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "false_clear",
        "false_block",
        "known_coverage",
        "clearance_error",
        "transition_consistency"
      ],
      "properties": {
        "false_clear": {
          "anyOf": [
            {
              "$ref": "#/$defs/proportion"
            },
            {
              "type": "null"
            }
          ]
        },
        "false_block": {
          "anyOf": [
            {
              "$ref": "#/$defs/proportion"
            },
            {
              "type": "null"
            }
          ]
        },
        "known_coverage": {
          "anyOf": [
            {
              "$ref": "#/$defs/proportion"
            },
            {
              "type": "null"
            }
          ]
        },
        "clearance_error": {
          "anyOf": [
            {
              "$ref": "#/$defs/nonnegativeFiniteNumber"
            },
            {
              "type": "null"
            }
          ]
        },
        "transition_consistency": {
          "anyOf": [
            {
              "$ref": "#/$defs/proportion"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "metricSums": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "false_clear",
        "false_block",
        "known_coverage",
        "clearance_error",
        "transition_consistency"
      ],
      "properties": {
        "false_clear": {
          "anyOf": [
            {
              "$ref": "#/$defs/nonnegativeFiniteNumber"
            },
            {
              "type": "null"
            }
          ]
        },
        "false_block": {
          "anyOf": [
            {
              "$ref": "#/$defs/nonnegativeFiniteNumber"
            },
            {
              "type": "null"
            }
          ]
        },
        "known_coverage": {
          "anyOf": [
            {
              "$ref": "#/$defs/nonnegativeFiniteNumber"
            },
            {
              "type": "null"
            }
          ]
        },
        "clearance_error": {
          "anyOf": [
            {
              "$ref": "#/$defs/nonnegativeFiniteNumber"
            },
            {
              "type": "null"
            }
          ]
        },
        "transition_consistency": {
          "anyOf": [
            {
              "$ref": "#/$defs/nonnegativeFiniteNumber"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "aggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metrics",
        "denominators"
      ],
      "properties": {
        "metrics": {
          "$ref": "#/$defs/qualityMetrics"
        },
        "denominators": {
          "$ref": "#/$defs/denominators"
        }
      }
    },
    "parentSession": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parent_id",
        "session_id",
        "metric_sums",
        "metrics",
        "denominators",
        "data_role"
      ],
      "properties": {
        "parent_id": {
          "type": "string",
          "minLength": 1
        },
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "metric_sums": {
          "$ref": "#/$defs/metricSums"
        },
        "metrics": {
          "$ref": "#/$defs/qualityMetrics"
        },
        "denominators": {
          "$ref": "#/$defs/denominators"
        },
        "data_role": {
          "const": "evaluation"
        }
      }
    },
    "subDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "reason_codes"
      ],
      "properties": {
        "decision": {
          "enum": [
            "PASS",
            "FAIL",
            "UNKNOWN"
          ]
        },
        "reason_codes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "proportion": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "denominators": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "false_clear",
        "false_block",
        "known_coverage",
        "clearance_error",
        "transition_consistency"
      ],
      "properties": {
        "false_clear": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "false_block": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "known_coverage": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "clearance_error": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "transition_consistency": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "rosterEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parent_id",
        "session_id",
        "data_role"
      ],
      "properties": {
        "parent_id": {
          "type": "string",
          "minLength": 1
        },
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "data_role": {
          "enum": [
            "training",
            "development",
            "evaluation"
          ]
        }
      }
    },
    "performanceSamples": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cold_start_ms",
        "warm_start_ms",
        "latency_ms",
        "memory_mb",
        "thermal_window_seconds"
      ],
      "properties": {
        "cold_start_ms": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonnegativeFiniteNumber"
          }
        },
        "warm_start_ms": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonnegativeFiniteNumber"
          }
        },
        "latency_ms": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonnegativeFiniteNumber"
          }
        },
        "memory_mb": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonnegativeFiniteNumber"
          }
        },
        "thermal_window_seconds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonnegativeFiniteNumber"
          }
        }
      }
    },
    "performanceSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cold_start_ms",
        "warm_start_ms",
        "latency_p50_ms",
        "latency_p95_ms",
        "peak_memory_mb",
        "thermal_window_seconds"
      ],
      "properties": {
        "cold_start_ms": {
          "anyOf": [
            {
              "$ref": "#/$defs/nonnegativeFiniteNumber"
            },
            {
              "type": "null"
            }
          ]
        },
        "warm_start_ms": {
          "anyOf": [
            {
              "$ref": "#/$defs/nonnegativeFiniteNumber"
            },
            {
              "type": "null"
            }
          ]
        },
        "latency_p50_ms": {
          "anyOf": [
            {
              "$ref": "#/$defs/nonnegativeFiniteNumber"
            },
            {
              "type": "null"
            }
          ]
        },
        "latency_p95_ms": {
          "anyOf": [
            {
              "$ref": "#/$defs/nonnegativeFiniteNumber"
            },
            {
              "type": "null"
            }
          ]
        },
        "peak_memory_mb": {
          "anyOf": [
            {
              "$ref": "#/$defs/nonnegativeFiniteNumber"
            },
            {
              "type": "null"
            }
          ]
        },
        "thermal_window_seconds": {
          "anyOf": [
            {
              "$ref": "#/$defs/nonnegativeFiniteNumber"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "performanceRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parent_id",
        "session_id",
        "device_run_id",
        "samples",
        "summary"
      ],
      "properties": {
        "parent_id": {
          "type": "string",
          "minLength": 1
        },
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "device_run_id": {
          "type": "string",
          "minLength": 1
        },
        "samples": {
          "$ref": "#/$defs/performanceSamples"
        },
        "summary": {
          "$ref": "#/$defs/performanceSummary"
        }
      }
    }
  }
}
