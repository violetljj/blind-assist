+// Publish ownership exactly as the upstream VSYNC path does. Never copy or
+// reinterpret timestamps; the native SOI belongs to cam_start_frame's stamp.
+static void ba_publish_frame(int frame_pos, camera_fb_t *frame)
+{
+    cam_obj->frames[frame_pos].en = 0;
+    if (xQueueSend(cam_obj->frame_buffer_queue, &frame, 0) != pdTRUE) {
+        camera_fb_t *old_frame = NULL;
+        if (xQueueReceive(cam_obj->frame_buffer_queue, &old_frame, 0) == pdTRUE) {
+            if (xQueueSend(cam_obj->frame_buffer_queue, &frame, 0) != pdTRUE) {
+                cam_obj->frames[frame_pos].en = 1;
+            }
+            cam_give(old_frame);
+        } else {
+            cam_obj->frames[frame_pos].en = 1;
+        }
+    }
+}
