{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Future CNH evaluator-only per-query object attribution",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "authority", "source_manifest_sha256", "frame_key", "layout_id", "queries"],
  "properties": {
    "schema": {"const": "cnh-query-object-attribution-v1"},
    "authority": {"const": "EVALUATOR_ONLY_PHYSICAL_TRIANGLE_BOX_CONTACT"},
    "source_manifest_sha256": {"$ref": "#/$defs/hash"},
    "frame_key": {"$ref": "#/$defs/hash"},
    "layout_id": {"type": "string", "minLength": 1},
    "queries": {
      "type": "object", "additionalProperties": false,
      "required": ["left_HEAD", "left_BODY", "centre_HEAD", "centre_BODY", "right_HEAD", "right_BODY"],
      "properties": {
        "left_HEAD": {"$ref": "#/$defs/query"}, "left_BODY": {"$ref": "#/$defs/query"},
        "centre_HEAD": {"$ref": "#/$defs/query"}, "centre_BODY": {"$ref": "#/$defs/query"},
        "right_HEAD": {"$ref": "#/$defs/query"}, "right_BODY": {"$ref": "#/$defs/query"}
      }
    }
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "object": {
      "type": "object", "additionalProperties": false,
      "required": ["object_id", "source_kind", "source_instance_key", "geometry_sha256", "category", "thin_rod", "annotation_provenance"],
      "properties": {
        "object_id": {"type": "string", "minLength": 1},
        "source_kind": {"enum": ["NATIVE", "INSERTED"]},
        "source_instance_key": {"type": "string", "minLength": 1},
        "geometry_sha256": {"$ref": "#/$defs/hash"},
        "category": {"type": ["string", "null"], "minLength": 1},
        "thin_rod": {"type": ["boolean", "null"]},
        "annotation_provenance": {"type": ["string", "null"], "minLength": 1}
      },
      "allOf": [{
        "if": {"anyOf": [{"properties": {"category": {"type": "string"}}}, {"properties": {"thin_rod": {"type": "boolean"}}}]},
        "then": {"properties": {"annotation_provenance": {"type": "string", "minLength": 1}}}
      }]
    },
    "query": {
      "type": "object", "additionalProperties": false,
      "required": ["label", "coverage", "attribution_status", "objects"],
      "properties": {
        "label": {"enum": [-1, 0, 1]},
        "coverage": {"enum": ["COMPLETE", "INCOMPLETE"]},
        "attribution_status": {"enum": ["COMPLETE", "PARTIAL", "UNKNOWN"]},
        "objects": {"type": ["array", "null"], "items": {"$ref": "#/$defs/object"}, "uniqueItems": true}
      },
      "oneOf": [
        {"properties": {"label": {"const": 0}, "coverage": {"const": "COMPLETE"}, "attribution_status": {"const": "COMPLETE"}, "objects": {"type": "array", "maxItems": 0}}},
        {"properties": {"label": {"const": -1}, "coverage": {"const": "INCOMPLETE"}, "attribution_status": {"const": "UNKNOWN"}, "objects": {"type": "null"}}},
        {"properties": {"label": {"const": 1}, "coverage": {"const": "COMPLETE"}, "attribution_status": {"const": "COMPLETE"}, "objects": {"type": "array", "minItems": 1}}},
        {"properties": {"label": {"const": 1}, "coverage": {"const": "INCOMPLETE"}, "attribution_status": {"const": "PARTIAL"}, "objects": {"type": "array", "minItems": 1}}}
      ]
    }
  }
}
