{
  "schema_version": 1,
  "experiment_id": "DTR_CARLA_C0_CAUSAL_BENCHMARK_CANARY_V1",
  "evidence_class": "synthetic_causal_development_canary",
  "objective": "Run the unchanged frozen DTR R2 logic across six paired CARLA interventions and four observation levels while changing only the observable source presented to R2.",
  "environment": {
    "carla_version": "0.9.16",
    "map": "Carla/Maps/Town10HD_Opt",
    "weather": "ClearNoon",
    "duration_seconds": 8.0,
    "sample_seconds": 0.05,
    "simulation_tick_seconds": 0.025,
    "walker_origin_z_m": 0.9516997933387756,
    "anchor": {
      "center_xy_m": [-46.934195, 36.51329],
      "forward_xy": [0.999999564, 0.000933925],
      "right_xy": [-0.000933925, 0.999999564]
    }
  },
  "camera": {
    "resolution": [320, 180],
    "fov_degrees": 90.0,
    "relative_transform": {
      "x_m": 0.0,
      "y_m": 0.0,
      "z_m": 0.65,
      "pitch_degrees": -12.0,
      "yaw_degrees": 10.0,
      "roll_degrees": 0.0
    }
  },
  "capture": {
    "sensor_order": ["instance", "rgb", "depth", "flow"],
    "one_long_lived_camera_per_modality": true,
    "fresh_server_per_modality": true,
    "actor_blueprints": {
      "ego": "walker.pedestrian.0001",
      "target": "walker.pedestrian.0002",
      "occluder": "static.prop.advertisement"
