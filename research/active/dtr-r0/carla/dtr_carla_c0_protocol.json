  "observation_ladder": {
    "O0_RGB": "YOLO person bbox, causal image tracker, and frozen flat-ground projection",
    "O1_RGB_DEPTH": "The same RGB detections and tracks with CARLA depth replacing flat-ground range",
    "O2T_RGB_DEPTH_CARLA_FLOW": "O1 plus bounded 0.50-second transport from CARLA sensor flow; synthetic teacher arm, not deployment flow",
    "O3_PRIVILEGED_CURRENT_STATE": "Current CARLA target identity and metric position only; privileged Oracle prediction ceiling",
    "Y_REALIZED_FUTURE_TRUTH": "Realized future OBB/contact opened by the scorer only after prediction SHA-256 is sealed"
  },
  "twin_contracts": [
    {
      "family": "same_geometry_different_motion",
      "a": "motion_cross",
      "b": "motion_hold",
      "identical_before_s": 1.0,
      "allowed_difference": "target_velocity_after_1s"
    },
    {
      "family": "same_motion_different_route",
      "a": "route_straight",
      "b": "route_turn_right",
      "identical_before_s": 2.0,
      "allowed_difference": "ego_route_velocity_after_2s"
    },
    {
      "family": "same_motion_different_ttc",
      "a": "ttc_early",
      "b": "ttc_delayed",
      "identical_before_s": 0.0,
      "allowed_difference": "target_motion_start_time"
    },
    {
      "family": "same_scene_different_visibility",
      "a": "visibility_forward",
      "b": "visibility_head_away",
      "identical_before_s": 2.4,
      "allowed_difference": "sensor_yaw_only_between_2.4s_and_4.6s",
      "visibility_gate": {
        "window_start_s": 2.4,
        "window_end_s": 4.6,
        "minimum_visible_frame_drop": 20
      }
    },
    {
      "family": "same_target_visible_then_occluded",
      "a": "occlusion_clear",
      "b": "occlusion_blocked",
      "identical_before_s": 0.0,
      "allowed_difference": "physical_occluder_presence",
      "visibility_gate": {
        "minimum_visible_frame_drop": 5
      }
    },
    {
      "family": "same_background_static_then_dynamic",
      "a": "background_static",
      "b": "background_dynamic",
      "identical_before_s": 1.0,
      "allowed_difference": "off_route_target_velocity_after_1s"
    }
  ],
  "scenarios": [
