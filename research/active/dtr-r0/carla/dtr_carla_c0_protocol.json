      "family": "same_geometry_different_motion",
      "twin": "a",
      "expected_critical": true,
      "ego": {"start_forward_m": -4.0, "start_right_m": 0.0, "segments": [{"start_s": 0.0, "velocity_forward_mps": 1.0, "velocity_right_mps": 0.0}]},
      "target": {"start_forward_m": 0.0, "start_right_m": 4.0, "segments": [{"start_s": 0.0, "velocity_forward_mps": 0.0, "velocity_right_mps": 0.0}, {"start_s": 1.0, "velocity_forward_mps": 0.0, "velocity_right_mps": -1.3333333333333333}]}
