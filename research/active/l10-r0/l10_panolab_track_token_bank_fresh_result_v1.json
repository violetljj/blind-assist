  "evidence_semantics": {
    "predecessor": "The frozen whole-row exact-name plus grouped two-initial brand-sign matcher, evaluated both after-only and as a two-frame union.",
    "successor": "A long-short memory bank of exact target-name tokens pooled across OCR rows and the verified start/after action edge.",
    "counterfactuals": "Each episode's two-frame bank is evaluated against all three other fresh target names, for twelve wrong-target trials.",
    "component_separation": "Lexical candidates, geometry roles, and entrance rays remain separate fields; no ownership binding is emitted."
  },
  "research_basis": [
    {
      "title": "GoMatching++: Parameter- and Data-Efficient Arbitrary-Shaped Video Text Spotting and Benchmarking",
      "url": "https://arxiv.org/abs/2505.22228",
      "official_code": "https://github.com/Hxyz-123/GoMatching",
      "use": "Its long- and short-term matching memory motivates pooling stable text evidence across recent and historical frames; this evaluator uses a deterministic exact-token bank rather than its learned tracker."
    },
    {
      "title": "GloTSFormer: Global Video Text Spotting Transformer",
      "url": "https://arxiv.org/abs/2401.03694",
      "use": "Its global historical association motivates retaining evidence beyond adjacent-frame-only matching; this evaluator does not implement the Transformer or claim benchmark comparability."
    }
  ],
  "claim_boundary": {
    "allowed": "Fresh target-way/item/prior-active-sequence-disjoint Development evidence, on four selected Panoramax episodes across three cities, about whether a component-separated long-short exact-token bank improves lexical-candidate availability over the frozen predecessor while post-action geometry remains independently DIRECT.",
    "not_allowed": [
      "source-provider-disjoint confirmation or broad generalization",
      "a lexical candidate being the target entity rather than a same-name sign, street, or distractor",
      "pixel portal grounding or address/sign-to-door ownership",
      "entrance affordance, public/legal access, walkability, collision-free traversability",
      "waypoint accuracy, arrival, HANDOFF_READY, user benefit, deployment performance, or safety"
    ]
  }
