<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.hardware.camera"
        android:required="true" />

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:name=".BlindAssistApplication"
        android:allowBackup="false"
        android:label="BlindAssist NPU Candidate"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="false">
        <uses-native-library
            android:name="libcdsprpc.so"
            android:required="false" />
        <meta-data
            android:name="com.linnan.blindassist.vision.OBJECT_DETECTOR_PROVIDER"
            android:value="com.linnan.blindassist.npu.QnnHtpObjectDetectorProvider" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
