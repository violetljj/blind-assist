{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blindassist.local/schemas/taro/p0/schema-bundle-2026-08-10",
  "title": "BlindAssist TARO P0 schema bundle",
  "schema_version": "blindassist.taro.p0.schema_bundle.v1",
  "$defs": {
    "FiniteNumber": {
      "type": "number"
    },
    "Vector2": {
      "type": "array",
      "items": {"$ref": "#/$defs/FiniteNumber"},
      "minItems": 2,
      "maxItems": 2
    },
    "Vector3": {
      "type": "array",
      "items": {"$ref": "#/$defs/FiniteNumber"},
      "minItems": 3,
      "maxItems": 3
    },
    "Matrix3": {
      "type": "array",
      "items": {"$ref": "#/$defs/FiniteNumber"},
      "minItems": 9,
      "maxItems": 9
    },
    "Matrix4": {
      "type": "array",
      "items": {"$ref": "#/$defs/FiniteNumber"},
      "minItems": 16,
      "maxItems": 16
    },
    "Covariance4": {
      "type": "array",
      "items": {"$ref": "#/$defs/FiniteNumber"},
      "minItems": 16,
      "maxItems": 16
    },
    "ReasonCode": {
      "type": "string",
      "enum": [
        "NONE",
        "MISSING_METRIC_ANCHOR",
        "ANCHOR_INVALID",
        "ANCHOR_SHUFFLED",
        "K_INVALID",
        "TRANSFORM_INVALID",
        "CLOCK_INVALID",
        "POSE_INVALID",
        "TRACKS_INSUFFICIENT",
        "PURE_ROTATION_SCALE_WEAK",
        "BASELINE_TOO_SMALL",
        "WEAK_QUERY_DIRECTION",
        "NONSMOOTH_CONTACT_SWITCH",
        "DYNAMIC_FOREGROUND",
        "FACTOR_INVALID",
        "UNSUPPORTED_STATE_BLOCK",
        "BODY_MOTION_FORBIDDEN",
        "ACTION_NOT_REALIZED",
        "NUMERICAL_FAILURE"
      ]
    },
    "Governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data_role",
        "outcome_access",
        "selection_influence",
        "provenance",
        "license_use_scope"
      ],
      "properties": {
        "data_role": {
          "type": "string",
          "enum": [
            "ANALYTIC_SYNTHETIC_CANARY",
            "BURNED_DEVELOPMENT_DIAGNOSTIC",
            "FRESH_DEVELOPMENT",
            "CONFIRMATION"
          ]
        },
        "outcome_access": {
          "type": "string",
          "enum": ["NONE", "FULL", "PROTECTED"]
        },
        "selection_influence": {"type": "boolean"},
        "provenance": {"type": "string", "minLength": 1},
        "license_use_scope": {"type": "string", "minLength": 1}
      }
    },
    "TaroFrameReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "source_id",
        "session_id",
        "parent_id",
        "frame_id",
        "capture_id",
        "site_id",
        "device_id",
        "mount_id",
        "sensor_timestamp_ns",
        "max_source_timestamp_ns",
        "clock",
        "image_geometry",
        "camera",
        "pose",
        "imu",
        "sparse_tracks",
        "metric_anchor",
        "factor_identity",
        "body_profile_id",
        "path_id",
        "query_id",
        "action_budget",
        "governance"
      ],
      "properties": {
        "schema": {"const": "blindassist.taro.frame_receipt.v1"},
        "source_id": {"type": "string", "minLength": 1},
        "session_id": {"type": "string", "minLength": 1},
        "parent_id": {"type": "string", "minLength": 1},
        "frame_id": {"type": "string", "minLength": 1},
        "capture_id": {"type": "string", "minLength": 1},
        "site_id": {"type": "string", "minLength": 1},
        "device_id": {"type": "string", "minLength": 1},
        "mount_id": {"type": "string", "minLength": 1},
        "sensor_timestamp_ns": {"type": "integer", "minimum": 0},
        "max_source_timestamp_ns": {"type": "integer", "minimum": 0},
        "clock": {
          "type": "object",
          "additionalProperties": false,
          "required": ["domain", "monotonic_valid", "cross_clock_valid", "sync_sigma_ms"],
          "properties": {
            "domain": {"type": "string", "minLength": 1},
            "monotonic_valid": {"type": "boolean"},
            "cross_clock_valid": {"type": "boolean"},
            "sync_sigma_ms": {"type": "number", "minimum": 0}
          }
        },
        "image_geometry": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "buffer_shape_hw",
            "display_shape_hw",
            "model_shape_hw",
            "orientation",
            "crop_xywh",
            "resize_mode",
            "transform_chain_valid"
          ],
          "properties": {
            "buffer_shape_hw": {
              "type": "array",
              "items": {"type": "integer", "minimum": 1},
              "minItems": 2,
              "maxItems": 2
            },
            "display_shape_hw": {
              "type": "array",
              "items": {"type": "integer", "minimum": 1},
              "minItems": 2,
              "maxItems": 2
            },
            "model_shape_hw": {
              "type": "array",
              "items": {"type": "integer", "minimum": 1},
              "minItems": 2,
              "maxItems": 2
            },
            "orientation": {"type": "string", "enum": ["portrait", "landscape"]},
            "crop_xywh": {
              "type": "array",
              "items": {"type": "integer", "minimum": 0},
              "minItems": 4,
              "maxItems": 4
            },
            "resize_mode": {"type": "string", "enum": ["stretch", "letterbox", "center_crop"]},
            "transform_chain_valid": {"type": "boolean"}
          }
        },
        "camera": {
          "type": "object",
          "additionalProperties": false,
          "required": ["physical_camera_id", "k_eff", "distortion", "source", "valid"],
          "properties": {
            "physical_camera_id": {"type": "string", "minLength": 1},
            "k_eff": {"$ref": "#/$defs/Matrix3"},
            "distortion": {
              "type": "array",
              "items": {"$ref": "#/$defs/FiniteNumber"},
              "minItems": 0,
              "maxItems": 14
            },
            "source": {"type": "string", "minLength": 1},
            "valid": {"type": "boolean"}
          }
        },
        "pose": {
          "type": "object",
          "additionalProperties": false,
          "required": ["t_world_camera", "covariance_6x6", "source", "quality", "valid"],
          "properties": {
            "t_world_camera": {"$ref": "#/$defs/Matrix4"},
            "covariance_6x6": {
              "type": "array",
              "items": {"$ref": "#/$defs/FiniteNumber"},
              "minItems": 36,
              "maxItems": 36
            },
            "source": {"type": "string", "minLength": 1},
            "quality": {"type": "number", "minimum": 0, "maximum": 1},
            "valid": {"type": "boolean"}
          }
        },
        "imu": {
          "type": "object",
          "additionalProperties": false,
          "required": ["gravity_camera", "covariance_3x3", "sync_valid", "valid"],
          "properties": {
            "gravity_camera": {"$ref": "#/$defs/Vector3"},
            "covariance_3x3": {"$ref": "#/$defs/Matrix3"},
            "sync_valid": {"type": "boolean"},
            "valid": {"type": "boolean"}
          }
        },
        "sparse_tracks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["track_id", "evidence_id", "source_group_id", "pixels_xy", "quality", "age_frames", "visible", "rejection_reason"],
            "properties": {
              "track_id": {"type": "string", "minLength": 1},
              "evidence_id": {"type": "string", "minLength": 1},
              "source_group_id": {"type": "string", "minLength": 1},
              "pixels_xy": {
                "type": "array",
                "items": {"$ref": "#/$defs/Vector2"},
                "minItems": 1
              },
              "quality": {"type": "number", "minimum": 0, "maximum": 1},
              "age_frames": {"type": "integer", "minimum": 1},
              "visible": {"type": "boolean"},
              "rejection_reason": {"type": ["string", "null"]}
            }
          }
        },
        "metric_anchor": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "value_m",
            "sigma_m",
            "valid",
            "validity_reason",
            "provenance",
            "identity",
            "source_independence_group",
            "source_timestamp_range_ns",
            "camera_body_transform_id",
            "shared_with_factor_predictor",
            "shared_with_oracle_truth",
            "shared_with_outcome"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": ["VIO_TRANSLATION", "KNOWN_HEIGHT", "DEPTH_SENSOR", "FIDUCIAL", "NONE"]
            },
            "value_m": {"type": ["number", "null"]},
            "sigma_m": {"type": ["number", "null"], "minimum": 0},
            "valid": {"type": "boolean"},
            "validity_reason": {"$ref": "#/$defs/ReasonCode"},
            "provenance": {"type": "string", "minLength": 1},
            "identity": {"type": "string", "minLength": 1},
            "source_independence_group": {"type": "string", "minLength": 1},
            "source_timestamp_range_ns": {
              "type": "array",
              "items": {"type": "integer", "minimum": 0},
              "minItems": 2,
              "maxItems": 2
            },
            "camera_body_transform_id": {"type": "string", "minLength": 1},
            "shared_with_factor_predictor": {"type": "boolean"},
            "shared_with_oracle_truth": {"type": "boolean"},
            "shared_with_outcome": {"type": "boolean"}
          }
        },
        "factor_identity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema_id", "producer_version", "content_sha256", "valid"],
          "properties": {
            "schema_id": {"type": "string", "minLength": 1},
            "producer_version": {"type": "string", "minLength": 1},
            "content_sha256": {"type": "string", "pattern": "^[0-9A-Fa-f]{64}$"},
            "valid": {"type": "boolean"}
          }
        },
        "body_profile_id": {"type": "string", "minLength": 1},
        "path_id": {"type": "string", "minLength": 1},
        "query_id": {"type": "string", "minLength": 1},
        "action_budget": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_candidates", "max_extra_frames", "max_duration_ms", "body_motion_allowed"],
          "properties": {
            "max_candidates": {"type": "integer", "minimum": 0},
            "max_extra_frames": {"type": "integer", "minimum": 0},
            "max_duration_ms": {"type": "integer", "minimum": 0},
            "body_motion_allowed": {"const": false}
          }
        },
        "governance": {"$ref": "#/$defs/Governance"}
      }
    },
    "TaroTaskQuery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "query_id",
        "frame_id",
        "body_profile_id",
        "path_id",
        "horizon_m",
        "swept_volume",
        "linearization_state",
        "query_jacobian_branches_m",
        "clear_margin_m",
        "occupied_margin_m",
        "deterministic_reducer_version"
      ],
      "properties": {
        "schema": {"const": "blindassist.taro.task_query.v1"},
        "query_id": {"type": "string", "minLength": 1},
        "frame_id": {"type": "string", "minLength": 1},
        "body_profile_id": {"type": "string", "minLength": 1},
        "path_id": {"type": "string", "minLength": 1},
        "horizon_m": {"type": "number", "exclusiveMinimum": 0},
        "swept_volume": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "half_width_m", "height_m", "inflation_m"],
          "properties": {
            "kind": {"const": "CAPSULE_CHAIN"},
            "half_width_m": {"type": "number", "exclusiveMinimum": 0},
            "height_m": {"type": "number", "exclusiveMinimum": 0},
            "inflation_m": {"type": "number", "minimum": 0}
          }
        },
        "linearization_state": {
          "type": "array",
          "items": {"$ref": "#/$defs/FiniteNumber"},
          "minItems": 4,
          "maxItems": 4
        },
        "query_jacobian_branches_m": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {"$ref": "#/$defs/FiniteNumber"},
            "minItems": 4,
            "maxItems": 4
          },
          "minItems": 1
        },
        "clear_margin_m": {"type": "number", "minimum": 0},
        "occupied_margin_m": {"type": "number", "maximum": 0},
        "deterministic_reducer_version": {"type": "string", "minLength": 1}
      }
    },
    "TaroFactorPosterior": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "frame_id",
        "query_id",
        "factor_reference",
        "state_order",
        "state_mean",
        "state_covariance",
        "measurement_singular_values",
        "observable_state_mask",
        "anchor_valid",
        "update_decision",
        "reason_codes",
        "query_interval_m",
        "query_identifiable",
        "query_state",
        "max_source_timestamp_ns",
        "input_provenance"
      ],
      "properties": {
        "schema": {"const": "blindassist.taro.factor_posterior.v1"},
        "frame_id": {"type": "string", "minLength": 1},
        "query_id": {"type": "string", "minLength": 1},
        "factor_reference": {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema_id", "content_sha256", "uncertainty_present"],
          "properties": {
            "schema_id": {"type": "string", "minLength": 1},
            "content_sha256": {"type": "string", "pattern": "^[0-9A-Fa-f]{64}$"},
            "uncertainty_present": {"type": "boolean"}
          }
        },
        "state_order": {
          "const": ["log_scale", "support_tangent_x", "support_tangent_y", "support_offset_m"]
        },
        "state_mean": {
          "type": "array",
          "items": {"$ref": "#/$defs/FiniteNumber"},
          "minItems": 4,
          "maxItems": 4
        },
        "state_covariance": {"$ref": "#/$defs/Covariance4"},
        "measurement_singular_values": {
          "type": "array",
          "items": {"type": "number", "minimum": 0},
          "minItems": 4,
          "maxItems": 4
        },
        "observable_state_mask": {
          "type": "object",
          "additionalProperties": false,
          "required": ["log_scale", "support_tangent_x", "support_tangent_y", "support_offset_m"],
          "properties": {
            "log_scale": {"type": "boolean"},
            "support_tangent_x": {"type": "boolean"},
            "support_tangent_y": {"type": "boolean"},
            "support_offset_m": {"type": "boolean"}
          }
        },
        "anchor_valid": {"type": "boolean"},
        "update_decision": {"type": "string", "enum": ["UPDATE_STRONG_SUBSPACE", "FREEZE", "ABSTAIN"]},
        "reason_codes": {
          "type": "array",
          "items": {"$ref": "#/$defs/ReasonCode"},
          "minItems": 1,
          "uniqueItems": true
        },
        "query_interval_m": {
          "type": "object",
          "additionalProperties": false,
          "required": ["lower", "upper", "coverage_level"],
          "properties": {
            "lower": {"type": ["number", "null"]},
            "upper": {"type": ["number", "null"]},
            "coverage_level": {"const": 0.95}
          }
        },
        "query_identifiable": {"type": "boolean"},
        "query_state": {
          "type": "string",
          "enum": ["CLEAR_OBSERVED", "OCCUPIED_OBSERVED", "UNKNOWN"]
        },
        "max_source_timestamp_ns": {"type": "integer", "minimum": 0},
        "input_provenance": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "TaroObservationCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "action_id",
        "frame_id",
        "query_id",
        "max_source_timestamp_ns",
        "input_provenance",
        "action_type",
        "requires_body_motion",
        "intended_camera_delta",
        "max_duration_ms",
        "predicted_visibility",
        "predicted_track_survival",
        "predicted_gauge_information",
        "predicted_query_risk_reduction",
        "predicted_baseline_m",
        "allowed",
        "filter_reason",
        "realized",
        "actual_receipt_frame_id",
        "realized_baseline_m",
        "failure_reason",
        "stop_after_action",
        "prompt_count"
      ],
      "properties": {
        "schema": {"const": "blindassist.taro.observation_candidate.v1"},
        "action_id": {"type": "string", "minLength": 1},
        "frame_id": {"type": "string", "minLength": 1},
        "query_id": {"type": "string", "minLength": 1},
        "max_source_timestamp_ns": {"type": "integer", "minimum": 0},
        "input_provenance": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "minItems": 1,
          "uniqueItems": true
        },
        "action_type": {
          "type": "string",
          "enum": ["STAY", "PASSIVE_HISTORY_FRAME", "PURE_ROTATION", "STATIONARY_CAMERA_MICRO_BASELINE"]
        },
        "requires_body_motion": {"type": "boolean"},
        "intended_camera_delta": {
          "type": "object",
          "additionalProperties": false,
          "required": ["translation_m", "rotation_axis_angle_rad"],
          "properties": {
            "translation_m": {"$ref": "#/$defs/Vector3"},
            "rotation_axis_angle_rad": {"$ref": "#/$defs/Vector3"}
          }
        },
        "max_duration_ms": {"type": "integer", "minimum": 0},
        "predicted_visibility": {"type": "number", "minimum": 0, "maximum": 1},
        "predicted_track_survival": {"type": "number", "minimum": 0, "maximum": 1},
        "predicted_gauge_information": {"type": "number", "minimum": 0},
        "predicted_query_risk_reduction": {"type": "number"},
        "predicted_baseline_m": {"type": "number", "minimum": 0},
        "allowed": {"type": "boolean"},
        "filter_reason": {"$ref": "#/$defs/ReasonCode"},
        "realized": {"type": "boolean"},
        "actual_receipt_frame_id": {"type": ["string", "null"]},
        "realized_baseline_m": {"type": ["number", "null"], "minimum": 0},
        "failure_reason": {"type": ["string", "null"]},
        "stop_after_action": {"type": "boolean"},
        "prompt_count": {"type": "integer", "minimum": 0}
      }
    }
  }
}
