{
  "schema": "blindassist.taro.p0.analytic_fixture_spec.v1",
  "suite_id": "TARO_P0_TASK_QUERY_IDENTIFIABILITY_AND_FACTOR_ORACLE_ANALYTIC_FIXTURES",
  "data_role": "ANALYTIC_SYNTHETIC_CANARY",
  "outcome_access": "NONE_PRE_EXECUTION_EXPECTATIONS_ONLY",
  "claim_ceiling": "Schema and analytic mechanics expectations only; not real factor causal headroom, learned performance, active-view utility, or product evidence.",
  "normalized_state": {
    "order": ["log_scale", "support_tangent_x", "support_tangent_y", "support_offset_m"],
    "one_unit": [0.1, 0.05, 0.05, 0.1],
    "physical_units": ["log-ratio", "radian", "radian", "metre"]
  },
  "identifiability_rule": {
    "measurement_matrix": "Whitened measurement-residual Jacobian only; exclude priors, damping, LM terms and regularizers.",
    "strong_singular_value_min": 1.0,
    "relative_singular_value_min": 0.001,
    "strong_rule": "sigma_i >= max(strong_singular_value_min, relative_singular_value_min * sigma_max)",
    "weak_trust_region_l2": 1.0,
    "task_ambiguity_radius_max_m": 0.02,
    "measurement_noise_budget_l2_95": 1.0,
    "measurement_interval_rule": "Project the frozen 95% whitened residual-noise ball through the strong-subspace pseudoinverse and query Jacobian. Report this half-width separately; it may widen the decision interval but may never add or remove measurement rank.",
    "contact_competition_margin_m": 0.01,
    "contact_branch_spread_max_m": 0.02,
    "required_receipts": [
      "metric_anchor_valid_and_parent_bound",
      "k_eff_valid",
      "transform_chain_valid",
      "clock_and_sync_valid",
      "factor_identity_valid"
    ],
    "update_rule": "Update only the strong right-singular subspace. Freeze every weak component; never turn a weak component into strong using a prior or regularizer.",
    "limiting_null_rule": "Null(F) subset Null(J_C) is reported as the zero-noise limiting diagnostic, not used alone as the finite gate."
  },
  "query_reducer": {
    "signed_clearance_zero": "contact",
    "clear_margin_m": 0.05,
    "occupied_margin_m": 0.0,
    "clear_rule": "query_identifiable and interval_lower_m > clear_margin_m",
    "occupied_rule": "query_identifiable and interval_upper_m <= occupied_margin_m",
    "unknown_rule": "all other cases, including invalid receipts, weak query direction and nonsmooth branch conflict",
    "final_state_owner": "deterministic TARO query reducer outside any learned graph, solver or action scorer"
  },
  "factorial_contract": {
    "factors": ["SCALE", "SUPPORT", "BOUNDARY"],
    "arms": [
      "NONE",
      "SCALE",
      "SUPPORT",
      "BOUNDARY",
      "SCALE_SUPPORT",
      "SCALE_BOUNDARY",
      "SUPPORT_BOUNDARY",
      "SCALE_SUPPORT_BOUNDARY"
    ],
    "oracle_modes": [
      "VALUE_ONLY_COMMON_SUPPORT",
      "FULL_BLOCK_VALUE_VALIDITY_UNCERTAINTY"
    ],
    "primary_real_comparison": "SCALE_SUPPORT_BOUNDARY versus NONE under VALUE_ONLY_COMMON_SUPPORT",
    "factor_specific_arms_role": "diagnostic_only_no_post_outcome_selection",
    "receipt_k_corruption": "separate negative control, never a factorial arm",
    "full_block_role": "reports coverage and uncertainty effects separately from value correction"
  },
