{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "blindassist.assistive_geometry_due.r0_source_manifest.v1",
  "title": "AG-DUE R0 metadata-only candidate source manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "manifest_id",
    "status",
    "source",
    "license",
    "ethics_privacy_access",
    "ancestry",
    "independence",
    "identity_roster",
    "access_receipt",
    "capabilities"
  ],
  "properties": {
    "schema": {"const": "blindassist.assistive_geometry_due.r0_source_manifest.v1"},
    "manifest_id": {"type": "string", "minLength": 8},
    "status": {"const": "SOURCE_DISCOVERY_METADATA_ONLY"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "source_family", "source_version", "identity_basis", "payload_presence"],
      "properties": {
        "source_id": {"type": "string", "minLength": 3},
        "source_family": {"type": "string", "minLength": 2},
        "source_version": {"type": "string", "minLength": 1},
        "identity_basis": {"type": "string", "minLength": 3},
        "payload_presence": {"enum": ["ABSENT", "LOCAL_EXISTING_NOT_OPENED", "UNKNOWN"]}
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["internal_research_status", "redistribution_status", "receipt"],
      "properties": {
        "internal_research_status": {"enum": ["VERIFIED_FOR_INTERNAL_RESEARCH", "UNKNOWN", "REJECTED"]},
        "redistribution_status": {"enum": ["VERIFIED", "NOT_AUTHORIZED", "UNKNOWN"]},
        "receipt": {"type": "string", "minLength": 3}
      }
    },
    "ethics_privacy_access": {
      "type": "object",
      "additionalProperties": false,
      "required": ["human_subject_presence", "privacy_review_status", "access_terms_status", "sensitive_content_handling", "receipt", "receipt_sha256"],
      "properties": {
        "human_subject_presence": {"enum": ["NONE", "POSSIBLE", "PRESENT", "UNKNOWN"]},
        "privacy_review_status": {"enum": ["VERIFIED_FOR_INTERNAL_RESEARCH", "REQUIRED_NOT_COMPLETE", "UNKNOWN"]},
        "access_terms_status": {"enum": ["VERIFIED", "UNKNOWN", "REJECTED"]},
        "sensitive_content_handling": {"type": "string", "minLength": 3},
        "receipt": {"type": "string", "minLength": 3},
        "receipt_sha256": {"type": "string", "pattern": "^[0-9A-F]{64}$"}
      }
    },
    "ancestry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "root_identity", "derivative_chain"],
      "properties": {
        "status": {"enum": ["VERIFIED", "UNKNOWN", "CONFLICT"]},
        "root_identity": {"type": "string", "minLength": 3},
        "derivative_chain": {"type": "array", "items": {"type": "string"}}
      }
    },
    "independence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "parent_identity_type", "independence_group_basis"],
      "properties": {
        "status": {"enum": ["VERIFIED", "UNKNOWN", "CONFLICT"]},
        "parent_identity_type": {"type": "string", "minLength": 2},
        "independence_group_basis": {"type": "string", "minLength": 3}
      }
    },
    "identity_roster": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parent_ids", "session_ids", "ancestry_group_ids", "history_roles", "claimed_freshness", "forbidden_roster_contract_sha256"],
      "properties": {
        "parent_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "session_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "ancestry_group_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "history_roles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["SOURCE_DISCOVERY", "TRAIN", "CANARY", "SYNTHETIC", "PROJECT_CONSUMED_DEVELOPMENT", "DEVELOPMENT_SELECTION", "DEVELOPMENT_CALIBRATION", "CALIBRATION", "CONFIRMATION", "SEALED_UNSEEN"]}},
        "claimed_freshness": {"enum": ["FRESH_SOURCE_DISCOVERY", "DISCLOSED_EXISTING_TRAIN", "CONSUMED_OR_PROTECTED", "UNKNOWN"]},
        "forbidden_roster_contract_sha256": {"type": "string", "pattern": "^[0-9A-F]{64}$"}
      }
    },
    "access_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "payload_opened",
        "rgb_visual_access",
        "geometry_payload_access",
        "model_outcome_access",
        "confirmation_outcome_access",
        "selection_or_tuning_influence"
      ],
      "properties": {
        "payload_opened": {"const": false},
        "rgb_visual_access": {"const": false},
        "geometry_payload_access": {"const": false},
        "model_outcome_access": {"const": false},
        "confirmation_outcome_access": {"const": false},
        "selection_or_tuning_influence": {"const": false}
      }
    },
    "capabilities": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "total_frames",
          "orientation_frame_counts",
          "parent_frame_counts",
          "provenance_kind",
          "quality_status",
          "upgrade_path",
          "evidence_basis",
          "parent_identity_namespace",
          "orientation_and_camera_basis",
          "derivation_receipt",
          "teacher_receipts",
          "unknown_treated_as_negative"
        ],
        "properties": {
          "total_frames": {"type": "integer", "minimum": 0},
          "orientation_frame_counts": {
            "type": "object",
            "additionalProperties": false,
            "required": ["portrait", "landscape"],
            "properties": {
              "portrait": {"type": "integer", "minimum": 0},
              "landscape": {"type": "integer", "minimum": 0}
            }
          },
          "parent_frame_counts": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {"type": "integer", "minimum": 0}
          },
          "provenance_kind": {
            "enum": [
              "SOURCE_NATIVE_ANNOTATION",
              "SOURCE_NATIVE_SENSOR",
              "DETERMINISTIC_DERIVED",
              "TEACHER_CONSENSUS",
              "SINGLE_TEACHER_OR_HEURISTIC_PROPOSAL",
              "UNKNOWN"
            ]
          },
          "quality_status": {"enum": ["VALIDATED_FOR_CLAIM", "CHARACTERIZED_NOT_VALIDATED", "UNKNOWN"]},
          "upgrade_path": {"enum": ["NONE", "DETERMINISTIC_DERIVATION", "MULTI_TEACHER_CONSENSUS", "SINGLE_TEACHER", "HEURISTIC", "VLM_PROPOSAL"]},
          "evidence_basis": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "receipt",
              "receipt_sha256",
              "claim_id",
              "claim_definition",
              "count_basis",
              "source_object_sha256",
              "source_field_mapping",
              "alignment_registration_units_coordinate_receipt_sha256",
              "source_specific_verifier_sha256"
            ],
            "properties": {
              "kind": {"enum": ["TRACKED_PROJECT_MANIFEST", "PUBLISHED_SOURCE_MANIFEST", "SOURCE_SPECIFIC_INTEGRITY_AUDIT", "TEACHER_OR_HEURISTIC_PROPOSAL", "UNKNOWN"]},
              "receipt": {"type": "string", "minLength": 3},
              "receipt_sha256": {"type": "string", "pattern": "^[0-9A-F]{64}$"},
              "claim_id": {"type": "string", "minLength": 3},
              "claim_definition": {"type": "string", "minLength": 8},
              "count_basis": {"type": "string", "minLength": 8},
              "source_object_sha256": {"type": "string", "pattern": "^[0-9A-F]{64}$"},
              "source_field_mapping": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
              "alignment_registration_units_coordinate_receipt_sha256": {"type": "string", "pattern": "^[0-9A-F]{64}$"},
              "source_specific_verifier_sha256": {"type": "string", "pattern": "^[0-9A-F]{64}$"}
            }
          },
          "parent_identity_namespace": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"},
          "orientation_and_camera_basis": {"enum": ["DISPLAY_UPRIGHT_WITH_BOUND_CAMERA_K", "SOURCE_NATIVE_WITH_EXPLICIT_UPRIGHT_K_MAPPING", "NOT_APPLICABLE", "UNKNOWN"]},
          "derivation_receipt": {"type": ["string", "null"]},
          "teacher_receipts": {"type": "array", "items": {"type": "string"}},
          "unknown_treated_as_negative": {"const": false}
        }
      }
    }
  }
}
