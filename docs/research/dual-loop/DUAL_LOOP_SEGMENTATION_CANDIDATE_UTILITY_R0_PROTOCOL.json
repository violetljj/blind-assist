{
  "schema_version": "blindassist.dual_loop_segmentation_candidate_utility_r0.protocol.v1",
  "protocol_id": "DUAL_LOOP_SEGMENTATION_CANDIDATE_UTILITY_R0",
  "status": "DESIGN_FROZEN",
  "stage": "DEVELOPMENT_STANDARD",
  "executor": "violjjet",
  "question": "Does segmentation add objectively correct hazard pixels or hazard components outside the YOLO box union, and is the gain worth false activation, temporal instability, and host compute cost?",
  "claim_ceiling": "source_native_pixel_component_utility_development_only",
  "forbidden_claims": [
    "real_world_traversability",
    "risk_event_or_alert_effect",
    "Android_or_device_parity",
    "QNN_latency_or_energy",
    "production_model_promotion",
    "safety_or_independent_walking"
  ],
  "data_roles": {
    "pixel_truth": {
      "role": "held_out_source_native_pixel_truth",
      "dataset": "SANPO-Real v0",
      "canonical_dataset_root": "test-artifacts.local/datasets/sanpo-v4-real-canonical-r3-20260713",
      "calibration_manifest": "training_manifest.jsonl",
      "calibration_split": "dev",
      "formal_test_manifest": "blind_holdout/manifest.jsonl",
      "formal_test_split": "blind",
      "label_authority": "source_ground_truth",
      "mask_field": "semantic_mask_path",
      "mask_sha_field": "semantic_mask_sha256",
      "class_id_mapping": {
        "0": "walkable",
        "1": "boundary_step_curb",
        "2": "obstacle",
        "3": "unknown_nonwalkable"
      },
      "role_boundary": "Only pixel/component validity is evaluated here; this source does not supply natural-video temporal transfer evidence."
    },
    "temporal_transfer": {
      "role": "natural_video_temporal_and_source_transfer_diagnostic",
      "sources": [
        "commons_iran_shiraz_city_tour_2021_5",
        "commons_shanghai_shopping_street_night_2024"
      ],
      "truth_access": "none",
      "required_motion_warp_input": true,
      "role_boundary": "Shiraz and Shanghai report raw and motion-warped candidate stability only; they do not score pixel truth or fusion effect."
    }
  },
  "hazard_mask": {
    "primary_classes": ["obstacle", "boundary_step_curb"],
    "primary_operator": "predicted_class_id in {1,2}",
    "unknown_nonwalkable": {
      "role": "separate_ablation_only",
      "operator": "predicted_class_id == 3",
      "excluded_from_default_hazard": true
    }
  },
  "arms": {
    "A": {
      "name": "YOLO-only",
      "mask": "D_t = union of all projected YOLO rectangles",
      "detector_thresholds": "inherited from the bound trace; no threshold tuning here"
    },
    "B": {
      "name": "Segmentation-only",
      "mask": "H_t = predicted obstacle union boundary_step_curb"
    },
    "C": {
      "name": "YOLO + Segmentation",
      "mask": "D_t union H_t",
      "candidate_mask": "H_t minus D_t"
    }
  },
  "analysis": {
    "grid": {"width": 256, "height": 256, "projection": "nearest for source-native truth; clipped normalized boxes"},
    "identity_key": "source_id + frame_id + image_sha256",
    "frames_are_repeated_observations": true,
    "component_connectivity": 8,
    "component_hit_rule": "any positive intersection with source-native hazard component",
    "boundary_f1": "8-neighbor morphological boundary pixels",
    "temporal_match_iou": 0.10,
    "temporal_warp_direction": "matrix maps previous analysis-grid coordinates into current analysis-grid coordinates",
    "temporal_metrics": [
      "raw_adjacent_iou",
      "motion_warped_adjacent_iou",
      "candidate_births",
      "candidate_deaths",
      "persistence_p50_p90",
      "split_count",
      "merge_count",
      "flicker_track_count"
    ],
    "runtime_metrics": [
      "segmentation_p50_p95_ms",
      "component_extraction_p50_p95_ms",
      "fusion_p50_p95_ms",
      "total_increment_p50_p95_ms",
      "peak_memory_bytes_if_available"
    ]
  },
  "decision_gates": {
    "selection_rule": "Values are locked before formal blind-test access; calibration may only verify adequacy and cannot tune the formal result.",
    "min_delta_recall": 0.05,
    "max_delta_false_positive_area_fraction": 0.05,
    "min_candidate_component_recall": 0.50,
    "max_false_activation_components_per_frame": 3.0,
    "min_consistent_source_sessions": 2,
    "min_consistent_session_delta_recall": 0.0,
    "max_segmentation_p95_ms_host": 25.0,
    "max_incremental_p95_ms_host": 30.0,
    "motion_warped_iou_required_for_report": true,
    "motion_warped_iou_required_for_pixel_utility_terminal": false
  },
  "terminals": {
    "supported": "CANDIDATE_UTILITY_SUPPORTED",
    "rejected": "CURRENT_SEGMENTATION_REFERENCE_REJECTED",
    "input_failure": "CANDIDATE_UTILITY_NOT_EVALUABLE",
    "post_terminal_actions": {
      "supported": "Only a separately frozen model/fusion and device benchmark may follow; this protocol does not authorize them.",
      "rejected": "Close this segmentation reference; do not widen unknown_nonwalkable, tune many thresholds, add Agent labels, add a complex state machine, or connect active alerts."
    }
  },
  "implementation": {
    "module": "scripts/research/dual_loop_segmentation_candidate_utility",
    "evaluator": "evaluate_candidate_utility.py",
    "validator": "validate_candidate_utility.py",
    "component_metrics": "component_metrics.py",
    "temporal_metrics": "temporal_metrics.py",
    "outputs_root": "artifacts.local/evidence/dual-loop-segmentation-candidate-utility-r0",
    "forbidden_inputs": ["risk", "feedback", "event", "central_obstruction_agent_labels"]
  }
}
