{
  "schema_version": "blindassist.dual_loop_segmentation_r2_p0.protocol_draft.v1",
  "protocol_id": "DUAL_LOOP_SEGMENTATION_R2_P0",
  "status": "DRAFT_NOT_AUTHORIZED_FOR_FORMAL",
  "stage": "DEVELOPMENT_STANDARD_READINESS",
  "executor": "violjjet",
  "question": "Does one newly identified DDRNet-23-Slim pipeline candidate satisfy every frozen utility and host-runtime gate with enough Development margin, after a complete canonical-view rehearsal, to justify burning a new R2 holdout?",
  "candidate_strategy": "single_candidate_qualification",
  "rationale": "R1 already showed that DDRNet has acceptable host inference cost but excessive false activation, while SegFormer-B0 misses the host runtime gates by a wide margin. R2-P0 therefore permits one bounded DDRNet postprocess refinement and keeps SegFormer-B0 as a frozen comparator only.",
  "claim_ceiling": "development_readiness_to_design_r2_formal_only",
  "current_terminals": [
    "SEGMENTATION_MODEL_SELECTION_R1_BLOCKED",
    "MODEL_SELECTION_NOT_EVALUABLE",
    "R2_NOT_AUTHORIZED",
    "DEVICE_BENCHMARK_NOT_AUTHORIZED",
    "DEFAULT_APP_UNCHANGED"
  ],
  "forbidden_actions": [
    "repair_or_rerun_R1",
    "reuse_R1_consumed_fresh_as_unseen",
    "select_download_or_read_new_formal_mask_truth",
    "run_candidate_outputs_on_new_holdout",
    "Android",
    "QNN",
    "device_benchmark",
    "risk_or_event_evaluation",
    "active_reminder",
    "route_B",
    "gate_relaxation"
  ],
  "data_policy": {
    "allowed_pixel_truth_roles": [
      "train",
      "dev",
      "consumed_old_blind",
      "r1_consumed_fresh",
      "synthetic_canary"
    ],
    "new_holdout_access": "metadata_only_no_mask_object_download_no_mask_pixel_read",
    "r1_consumed_fresh_permanent_role": "regression_rehearsal_validator_only",
    "identity_laundering_forbidden": [
      "copy",
      "rename",
      "remap",
      "repackage",
      "new_manifest_alias"
    ]
  },
  "canonicalization_contract": {
    "config": "configs/dual_loop_segmentation_r2_p0/canonicalization_contract.json",
    "schema": "configs/dual_loop_segmentation_r2_p0/materialized_canonical_view.schema.json",
    "materializer_interface": "python -m scripts.research.dual_loop_segmentation_r2_p0.materialize_canonical_view",
    "required_lock_fields": [
      "canonicalizer_code_sha256",
      "canonicalizer_config_sha256",
      "canonical_view_schema_sha256"
    ],
    "formal_evaluator_rule": "A future formal evaluator may read only a SHA-closed materialized canonical view and must reject source-native mask paths."
  },
  "rehearsal_contract": {
    "mode": "consumed_and_synthetic_only",
    "required_checks": [
      "manifest_identity",
      "canonical_ids_exact_subset_0_3",
      "frame_and_component_row_counts",
      "source_and_session_aggregates",
      "zero_row_fail_closed",
      "atomic_publish",
      "interruption_resume",
      "independent_full_recompute"
    ],
    "formal_authority_created": false
  },
  "runtime_contract": {
    "threads": 4,
    "warmup_frames": 20,
    "measured_frames": 200,
    "production_equivalent_exclusions": [
      "truth_metrics",
      "file_IO",
      "JSON_logging",
      "validator"
    ],
    "required_stages": [
      "preprocess",
      "tflite_inference",
      "output_dequantize_argmax",
      "component_extraction",
      "fusion_operator",
      "total_increment"
    ],
    "immutable_per_frame_rows_required": true,
    "independent_recompute": [
      "mean",
      "p50",
      "p90",
      "p95",
      "min",
      "max"
    ]
  },
  "formal_hard_gates_unchanged": {
    "min_delta_recall": 0.05,
    "max_delta_false_positive_area_fraction": 0.05,
    "min_candidate_component_recall": 0.5,
    "max_false_activation_components_per_frame": 3.0,
    "max_segmentation_host_p95_ms": 25.0,
    "max_total_incremental_host_p95_ms": 30.0,
    "min_consistent_sessions": 2
  },
  "readiness_margin_gates": {
    "min_delta_recall": 0.06,
    "max_delta_false_positive_area_fraction": 0.04,
    "min_candidate_component_recall": 0.55,
    "max_false_activation_components_per_frame": 2.5,
    "max_segmentation_host_p95_ms": 22.5,
    "max_total_incremental_host_p95_ms": 27.0,
    "min_consistent_sessions": 3,
    "interpretation": "A candidate must satisfy these stricter Development margins; satisfying only the unchanged formal threshold is insufficient to burn fresh truth."
  },
  "bounded_refinement": {
    "candidate_family": "DDRNet-23-Slim",
    "base_model_identity": "R1 frozen DDRNet-23-Slim INT8",
    "search_config": "configs/dual_loop_segmentation_r2_p0/ddrnet_refinement_search.json",
    "one_search_only": true,
    "selection_data": "canonical_dev_only",
    "consumed_data_use_after_selection": "rehearsal_and_regression_only",
    "every_postprocess_change_creates_new_identity": true
  },
  "pre_fresh_freeze_required": [
    "dev_frames",
    "dev_components",
    "dev_report",
    "runtime_rows",
    "YOLO_trace",
    "checkpoint",
    "TFLite",
    "postprocess_config",
    "evaluator",
    "validator"
  ],
  "terminal_rule": {
    "ready": "READY_FOR_R2_FORMAL",
    "stop": "R2_NOT_WORTH_BURNING_FRESH_HOLDOUT",
    "ready_requires": [
      "one_candidate_satisfies_all_readiness_margin_gates",
      "rehearsal_validator_VALID",
      "runtime_rows_validator_VALID",
      "all_pre_fresh_identities_hash_frozen",
      "remaining_holdout_metadata_only_availability_nonzero"
    ],
    "ready_does_not_authorize": [
      "new_truth_access",
      "R2_formal_execution",
      "device_benchmark",
      "Android_or_QNN",
      "production_or_alert_integration"
    ]
  }
}
