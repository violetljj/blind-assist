{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blindassist.local/schemas/p0_goal_grounding_label_quality_schema_v1.json",
  "title": "BlindAssist P0 Goal Grounding Silver Label Quality V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "quality_class",
    "admission_status",
    "evidence_flags",
    "gates",
    "conflicts",
    "teacher_independence",
    "evaluated_system_overlap",
    "admission_reasons",
    "rejection_reasons"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "quality_class": {"enum": ["SILVER_A_PRIMARY", "SILVER_B_MAP_GEOMETRY", "SILVER_C_TEACHER_SUPPORTED", "REJECT_AMBIGUOUS"]},
    "admission_status": {"enum": ["PRIMARY_ADMITTED", "SECONDARY_ADMITTED", "DEVELOPMENT_ONLY", "REJECTED"]},
    "evidence_flags": {
      "type": "array",
      "uniqueItems": true,
      "items": {"enum": ["MAP_ANCHORED", "GEOMETRY_VERIFIED", "MULTIVIEW_VERIFIED", "VLM_SUPPORTED", "TEACHER_CONSENSUS", "AMBIGUOUS", "ABSTAIN"]}
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "license_and_attribution_complete",
        "source_snapshots_frozen",
        "target_building_unique",
        "osm_anchor_unique",
        "candidate_map_anchored",
        "geometry_verified",
        "multiview_verified",
        "entrance_semantics_match_goal",
        "full_provenance_present",
        "ancestry_deduplicated"
      ],
      "properties": {
        "license_and_attribution_complete": {"type": "boolean"},
        "source_snapshots_frozen": {"type": "boolean"},
        "target_building_unique": {"type": "boolean"},
        "osm_anchor_unique": {"type": "boolean"},
        "candidate_map_anchored": {"type": "boolean"},
        "geometry_verified": {"type": "boolean"},
        "multiview_verified": {"type": "boolean"},
        "entrance_semantics_match_goal": {"type": "boolean"},
        "full_provenance_present": {"type": "boolean"},
        "ancestry_deduplicated": {"type": "boolean"}
      }
    },
    "conflicts": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "PLACE_BUILDING_CONFLICT",
          "OSM_BUILDING_CONFLICT",
          "ENTRANCE_TYPE_CONFLICT",
          "ANCHOR_DISTANCE_TIE",
          "POSE_OR_FOV_CONFLICT",
          "MULTIVIEW_CONFLICT",
          "OCR_MAP_CONFLICT",
          "VLM_MAP_CONFLICT",
          "TEACHER_DISAGREEMENT",
          "LICENSE_UNKNOWN",
          "PROVENANCE_INCOMPLETE",
          "ANCESTRY_OVERLAP"
        ]
      }
    },
    "teacher_independence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["declared_vote_count", "independent_lineage_count", "lineage_groups", "same_model_family_collapsed"],
      "properties": {
        "declared_vote_count": {"type": "integer", "minimum": 0},
        "independent_lineage_count": {"type": "integer", "minimum": 0},
        "lineage_groups": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "same_model_family_collapsed": {"type": "boolean"}
      }
    },
    "evaluated_system_overlap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "overlap_lineage_groups"],
      "properties": {
        "status": {"enum": ["NO_KNOWN_OVERLAP", "TEACHER_LINEAGE_OVERLAP", "UNKNOWN"]},
        "overlap_lineage_groups": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "admission_reasons": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "rejection_reasons": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "quality_score": {
      "description": "Optional descriptive score only; never overrides gates or conflicts.",
      "type": ["number", "null"],
      "minimum": 0,
      "maximum": 1
    }
  },
  "allOf": [
    {
      "if": {"properties": {"quality_class": {"const": "SILVER_A_PRIMARY"}}, "required": ["quality_class"]},
      "then": {
        "properties": {
          "admission_status": {"const": "PRIMARY_ADMITTED"},
          "evidence_flags": {
            "allOf": [
              {"contains": {"const": "MAP_ANCHORED"}},
              {"contains": {"const": "GEOMETRY_VERIFIED"}},
              {"contains": {"const": "MULTIVIEW_VERIFIED"}}
            ]
          },
          "conflicts": {"maxItems": 0},
          "evaluated_system_overlap": {"properties": {"status": {"const": "NO_KNOWN_OVERLAP"}}},
          "gates": {
            "properties": {
              "license_and_attribution_complete": {"const": true},
              "source_snapshots_frozen": {"const": true},
              "target_building_unique": {"const": true},
              "osm_anchor_unique": {"const": true},
              "candidate_map_anchored": {"const": true},
              "geometry_verified": {"const": true},
              "multiview_verified": {"const": true},
              "entrance_semantics_match_goal": {"const": true},
              "full_provenance_present": {"const": true},
              "ancestry_deduplicated": {"const": true}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"quality_class": {"const": "SILVER_B_MAP_GEOMETRY"}}, "required": ["quality_class"]},
      "then": {
        "properties": {
          "admission_status": {"const": "SECONDARY_ADMITTED"},
          "evidence_flags": {
            "allOf": [
              {"contains": {"const": "MAP_ANCHORED"}},
              {"contains": {"const": "GEOMETRY_VERIFIED"}}
            ]
          },
          "conflicts": {"maxItems": 0},
          "gates": {
            "properties": {
              "license_and_attribution_complete": {"const": true},
              "source_snapshots_frozen": {"const": true},
              "target_building_unique": {"const": true},
              "osm_anchor_unique": {"const": true},
              "candidate_map_anchored": {"const": true},
              "geometry_verified": {"const": true},
              "entrance_semantics_match_goal": {"const": true},
              "full_provenance_present": {"const": true},
              "ancestry_deduplicated": {"const": true}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"quality_class": {"const": "SILVER_C_TEACHER_SUPPORTED"}}, "required": ["quality_class"]},
      "then": {
        "properties": {
          "admission_status": {"const": "DEVELOPMENT_ONLY"},
          "evidence_flags": {"contains": {"const": "TEACHER_CONSENSUS"}}
        }
      }
    },
    {
      "if": {"properties": {"quality_class": {"const": "REJECT_AMBIGUOUS"}}, "required": ["quality_class"]},
      "then": {"properties": {"admission_status": {"const": "REJECTED"}, "rejection_reasons": {"minItems": 1}}}
    }
  ]
}
