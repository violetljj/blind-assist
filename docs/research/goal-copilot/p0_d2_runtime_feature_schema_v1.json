{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "P0-D2 runtime evidence feature row v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "episode_id",
    "venue_parent_id",
    "source_frame_ids",
    "selected_candidate_ids",
    "observed_feature_families",
    "place_identity",
    "entrance_relation",
    "candidate_competition",
    "brain_rank_margin"
  ],
  "properties": {
    "episode_id": {"type": "string"},
    "venue_parent_id": {"type": "string"},
    "source_frame_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "selected_candidate_ids": {"type": "array", "items": {"type": "string"}},
    "observed_feature_families": {
      "type": "array",
      "uniqueItems": true,
      "items": {"enum": ["PLACE_IDENTITY", "ENTRANCE_RELATION", "CANDIDATE_COMPETITION", "BRAIN_RANK_MARGIN"]}
    },
    "place_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ocr_goal_match", "logo_goal_match", "map_place_support", "missing"],
      "properties": {
        "ocr_goal_match": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "logo_goal_match": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "map_place_support": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "missing": {"type": "boolean"}
      }
    },
    "entrance_relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["direct_sign_candidate_relation", "facade_candidate_relation", "cross_view_agreement", "missing"],
      "properties": {
        "direct_sign_candidate_relation": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "facade_candidate_relation": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "cross_view_agreement": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "missing": {"type": "boolean"}
      }
    },
    "candidate_competition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_count", "near_tie_count", "selected_max_iou"],
      "properties": {
        "candidate_count": {"type": "integer", "minimum": 0},
        "near_tie_count": {"type": "integer", "minimum": 0},
        "selected_max_iou": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
      }
    },
    "brain_rank_margin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raw_action", "raw_confidence", "selected_provider_rank", "proposal_score_margin"],
      "properties": {
        "raw_action": {"enum": ["SELECT", "AMBIGUOUS", "ABSTAIN"]},
        "raw_confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "selected_provider_rank": {"type": ["integer", "null"], "minimum": 1},
        "proposal_score_margin": {"type": ["number", "null"]}
      }
    }
  }
}
