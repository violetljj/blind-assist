{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blindassist.local/schemas/p0_goal_grounding_episode_schema_v1.json",
  "title": "BlindAssist P0 Goal Grounding Silver Episode V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "episode_id",
    "natural_episode_id",
    "data_role",
    "goal",
    "provenance",
    "target_building",
    "visible_buildings",
    "observation_window",
    "entrance_candidates",
    "relations",
    "target_visible",
    "evidence",
    "label",
    "difficulty",
    "ancestry"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "episode_id": {"type": "string", "minLength": 1},
    "natural_episode_id": {"type": "string", "minLength": 1},
    "data_role": {"enum": ["DEV", "REGRESSION", "FRESH"]},
    "goal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["utterance", "poi_id", "poi_name", "requested_relation", "requested_entrance_type"],
      "properties": {
        "utterance": {"type": "string", "minLength": 1},
        "poi_id": {"type": "string", "minLength": 1},
        "poi_name": {"type": "string", "minLength": 1},
        "poi_category": {"type": ["string", "null"]},
        "requested_relation": {"const": "entrance_of"},
        "requested_entrance_type": {"enum": ["ANY", "MAIN", "SECONDARY", "SERVICE", "OTHER"]},
        "normalized_name": {"type": ["string", "null"]}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mapillary", "overture", "osm", "construction_protocol"],
      "properties": {
        "mapillary": {"$ref": "#/$defs/sourceProvenance"},
        "overture": {"$ref": "#/$defs/sourceProvenance"},
        "osm": {"$ref": "#/$defs/sourceProvenance"},
        "construction_protocol": {
          "type": "object",
          "additionalProperties": false,
          "required": ["protocol_id", "protocol_sha256", "upstream_commit"],
          "properties": {
            "protocol_id": {"const": "BA-P0-GOAL-GROUNDING-SILVER-V1"},
            "protocol_sha256": {"$ref": "#/$defs/sha256"},
            "upstream_commit": {"const": "3d3b85244b1a1ec2ba05a997d56d000936cc554a"}
          }
        }
      }
    },
    "target_building": {"$ref": "#/$defs/building"},
    "visible_buildings": {
      "type": "array",
      "items": {"$ref": "#/$defs/buildingVisibility"},
      "uniqueItems": true
    },
    "observation_window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["window_id", "mode", "frames"],
      "properties": {
        "window_id": {"type": "string", "minLength": 1},
        "mode": {"enum": ["SINGLE_IMAGE", "SEQUENCE_WINDOW", "MULTI_SEQUENCE_WINDOW"]},
        "frames": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/frame"}
        }
      }
    },
    "entrance_candidates": {
      "type": "array",
      "items": {"$ref": "#/$defs/candidate"}
    },
    "relations": {
      "type": "array",
      "items": {"$ref": "#/$defs/relation"}
    },
    "target_visible": {
      "type": "object",
      "additionalProperties": false,
      "required": ["building", "requested_entrance", "authority", "uncertainty"],
      "properties": {
        "building": {"enum": ["VISIBLE", "OUT_OF_VIEW", "UNKNOWN"]},
        "requested_entrance": {"enum": ["VISIBLE", "OUT_OF_VIEW", "OCCLUDED", "UNKNOWN"]},
        "authority": {"enum": ["MAP_GEOMETRY", "MULTIVIEW", "TEACHER_DERIVED", "UNKNOWN"]},
        "uncertainty": {"type": "string", "minLength": 1}
      }
    },
    "hard_negatives": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidate_id", "negative_type", "supporting_evidence_ids"],
        "properties": {
          "candidate_id": {"type": ["string", "null"], "minLength": 1},
          "negative_type": {
            "enum": [
              "WRONG_BUILDING_ENTRANCE",
              "WRONG_ENTRANCE_TYPE",
              "TARGET_OUT_OF_VIEW",
              "TARGET_BUILDING_VISIBLE_ENTRANCE_OUT_OF_VIEW",
              "MULTIPLE_SIMILAR_DOORS",
              "SIGNAGE_SPATIAL_CONFLICT"
            ]
          },
          "supporting_evidence_ids": {"$ref": "#/$defs/nonEmptyStringArray"}
        }
      },
      "default": []
    },
    "evidence": {
      "type": "array",
      "items": {"$ref": "#/$defs/evidence"}
    },
    "label": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "quality_class", "evidence_flags", "positive_candidate_ids", "abstain_reason", "quality_record"],
      "properties": {
        "status": {"enum": ["SILVER_POSITIVE", "SILVER_NEGATIVE", "AMBIGUOUS", "ABSTAIN", "INVALID"]},
        "quality_class": {"enum": ["SILVER_A_PRIMARY", "SILVER_B_MAP_GEOMETRY", "SILVER_C_TEACHER_SUPPORTED", "REJECT_AMBIGUOUS"]},
        "evidence_flags": {
          "type": "array",
          "items": {"enum": ["MAP_ANCHORED", "GEOMETRY_VERIFIED", "MULTIVIEW_VERIFIED", "VLM_SUPPORTED", "TEACHER_CONSENSUS", "AMBIGUOUS", "ABSTAIN"]},
          "uniqueItems": true
        },
        "positive_candidate_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "abstain_reason": {
          "type": ["string", "null"],
          "enum": [null, "INSUFFICIENT_EVIDENCE", "TARGET_OUT_OF_VIEW", "TARGET_ENTRANCE_OUT_OF_VIEW", "NON_UNIQUE_BUILDING", "NON_UNIQUE_ENTRANCE", "SOURCE_CONFLICT", "TEACHER_CONFLICT", "INVALID_POSE", "UNKNOWN_LICENSE", "OUT_OF_SCOPE"]
        },
        "quality_record": {"$ref": "p0_goal_grounding_label_quality_schema.json"}
      }
    },
    "difficulty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["building_count", "entrance_candidate_count", "same_building_entrance_count", "wrong_building_candidate_count", "target_min_side_px", "visibility_fraction", "view_angle_deg", "conditions"],
      "properties": {
        "building_count": {"type": "integer", "minimum": 0},
        "entrance_candidate_count": {"type": "integer", "minimum": 0},
        "same_building_entrance_count": {"type": "integer", "minimum": 0},
        "wrong_building_candidate_count": {"type": "integer", "minimum": 0},
        "target_min_side_px": {"type": ["number", "null"], "minimum": 0},
        "visibility_fraction": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "view_angle_deg": {"type": ["number", "null"], "minimum": 0, "maximum": 180},
        "conditions": {
          "type": "array",
          "items": {"enum": ["DAY", "NIGHT", "GLARE", "RAIN", "BLUR", "OCCLUSION", "DENSE_URBAN", "SIMILAR_FACADE", "MULTIPLE_DOORS", "SIGNAGE_CONFLICT", "NO_TEXT", "OTHER"]},
          "uniqueItems": true
        }
      }
    },
    "ancestry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parent_capture_id", "mapillary_sequence_ids", "target_building_id", "osm_entrance_ids", "near_duplicate_cluster_id", "geographic_block_id"],
      "properties": {
        "parent_capture_id": {"type": "string", "minLength": 1},
        "mapillary_sequence_ids": {"$ref": "#/$defs/nonEmptyStringArray"},
        "target_building_id": {"type": "string", "minLength": 1},
        "osm_entrance_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "near_duplicate_cluster_id": {"type": "string", "minLength": 1},
        "geographic_block_id": {"type": "string", "minLength": 1}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "nonEmptyStringArray": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "sourceProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_name", "snapshot_or_release", "record_ids", "license", "attribution", "retrieved_at", "content_sha256"],
      "properties": {
        "source_name": {"type": "string", "minLength": 1},
        "snapshot_or_release": {"type": "string", "minLength": 1},
        "record_ids": {"$ref": "#/$defs/nonEmptyStringArray"},
        "license": {"type": "string", "minLength": 1},
        "attribution": {"type": "string", "minLength": 1},
        "retrieved_at": {"type": "string", "format": "date-time"},
        "content_sha256": {"$ref": "#/$defs/sha256"},
        "source_url": {"type": ["string", "null"], "format": "uri"}
      }
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lon", "lat"],
      "properties": {
        "lon": {"type": "number", "minimum": -180, "maximum": 180},
        "lat": {"type": "number", "minimum": -90, "maximum": 90}
      }
    },
    "bbox": {
      "type": "array",
      "prefixItems": [{"type": "number"}, {"type": "number"}, {"type": "number"}, {"type": "number"}],
      "items": false,
      "minItems": 4,
      "maxItems": 4
    },
    "building": {
      "type": "object",
      "additionalProperties": false,
      "required": ["building_id", "overture_id", "source_record_ids", "crosswalk_method", "crosswalk_status", "geometry_sha256"],
      "properties": {
        "building_id": {"type": "string", "minLength": 1},
        "overture_id": {"type": "string", "minLength": 1},
        "source_record_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "crosswalk_method": {"enum": ["SOURCE_NATIVE", "CONTAINED_UNIQUE", "SPATIAL_UNIQUE", "AMBIGUOUS"]},
        "crosswalk_status": {"enum": ["ADMITTED", "AMBIGUOUS", "REJECTED"]},
        "geometry_sha256": {"$ref": "#/$defs/sha256"},
        "place_boundary_distance_m": {"type": ["number", "null"], "minimum": 0},
        "second_best_margin_m": {"type": ["number", "null"], "minimum": 0}
      }
    },
    "buildingVisibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["building_id", "visibility", "supporting_evidence_ids"],
      "properties": {
        "building_id": {"type": "string", "minLength": 1},
        "visibility": {"enum": ["VISIBLE", "OUT_OF_VIEW", "UNKNOWN"]},
        "supporting_evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frame_id", "mapillary_image_id", "sequence_id", "captured_at_ms", "width", "height", "camera_position", "heading_deg", "heading_kind", "camera_type", "is_panorama", "image_sha256"],
      "properties": {
        "frame_id": {"type": "string", "minLength": 1},
        "mapillary_image_id": {"type": "string", "minLength": 1},
        "sequence_id": {"type": "string", "minLength": 1},
        "captured_at_ms": {"type": "integer", "minimum": 0},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "camera_position": {"$ref": "#/$defs/point"},
        "heading_deg": {"type": "number", "minimum": 0, "exclusiveMaximum": 360},
        "heading_kind": {"enum": ["COMPUTED_COMPASS_ANGLE", "COMPASS_ANGLE"]},
        "camera_type": {"type": "string", "minLength": 1},
        "is_panorama": {"type": "boolean"},
        "horizontal_fov_deg": {"type": ["number", "null"], "exclusiveMinimum": 0, "maximum": 360},
        "image_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "source_frame_id", "bbox_xyxy", "generator_provenance", "predicted_building_id", "predicted_entrance_geo", "geometry_residuals", "candidate_status"],
      "properties": {
        "candidate_id": {"type": "string", "minLength": 1},
        "source_frame_id": {"type": "string", "minLength": 1},
        "bbox_xyxy": {"$ref": "#/$defs/bbox"},
        "mask_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "generator_provenance": {"$ref": "#/$defs/modelProvenance"},
        "predicted_building_id": {"type": ["string", "null"]},
        "predicted_entrance_geo": {"oneOf": [{"$ref": "#/$defs/point"}, {"type": "null"}]},
        "geometry_residuals": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ray_range_m", "candidate_anchor_distance_m", "second_anchor_margin_m"],
          "properties": {
            "ray_range_m": {"type": ["number", "null"], "minimum": 0},
            "candidate_anchor_distance_m": {"type": ["number", "null"], "minimum": 0},
            "second_anchor_margin_m": {"type": ["number", "null"], "minimum": 0}
          }
        },
        "candidate_status": {"enum": ["PREDICTED", "GEOMETRY_VERIFIED", "MAP_ANCHORED", "REJECTED"]}
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "building_id", "relation", "relation_status", "entrance_type", "supporting_evidence_ids"],
      "properties": {
        "candidate_id": {"type": "string", "minLength": 1},
        "building_id": {"type": "string", "minLength": 1},
        "relation": {"const": "entrance_of"},
        "relation_status": {"enum": ["SUPPORTED", "CONTRADICTED", "AMBIGUOUS", "UNKNOWN"]},
        "entrance_type": {"enum": ["MAIN", "YES", "SECONDARY", "SERVICE", "EMERGENCY", "EXIT", "NO", "OTHER", "UNKNOWN"]},
        "osm_entrance_id": {"type": ["string", "null"]},
        "supporting_evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "evidence_type", "source_frame_ids", "candidate_ids", "provider_role", "status", "provenance", "payload_sha256"],
      "properties": {
        "evidence_id": {"type": "string", "minLength": 1},
        "evidence_type": {"enum": ["MAP", "GEOMETRY", "MULTIVIEW", "VISION", "OCR_SIGNAGE", "SEMANTIC_VLM"]},
        "source_frame_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "candidate_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "provider_role": {"enum": ["MAP_ANCHOR", "GEOMETRY_TEACHER", "ENTRANCE_VISION_TEACHER", "OCR_SIGNAGE_TEACHER", "SEMANTIC_VLM_TEACHER", "OPTIONAL_INDEPENDENT_VLM"]},
        "status": {"enum": ["SUPPORTED", "CONTRADICTED", "AMBIGUOUS", "ABSTAIN", "NOT_RUN", "RUN_FAILED", "INVALID_OUTPUT"]},
        "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "provenance": {"$ref": "#/$defs/modelProvenance"},
        "payload_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "modelProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider_id", "model_id", "model_version", "weights_sha256", "config_sha256", "prompt_sha256", "input_sha256", "candidate_source", "lineage_group"],
      "properties": {
        "provider_id": {"type": "string", "minLength": 1},
        "model_id": {"type": "string", "minLength": 1},
        "model_version": {"type": "string", "minLength": 1},
        "weights_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "config_sha256": {"$ref": "#/$defs/sha256"},
        "prompt_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "input_sha256": {"$ref": "#/$defs/sha256"},
        "candidate_source": {"type": "string", "minLength": 1},
        "lineage_group": {"type": "string", "minLength": 1}
      }
    }
  }
}
