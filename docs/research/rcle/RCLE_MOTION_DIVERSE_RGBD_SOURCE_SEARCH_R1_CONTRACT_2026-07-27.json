    "geometry_role_authority": true,
    "stop_at_first_geometry_usable_cohort": true,
    "post_geometry_window_invention": false,
    "algorithm_change_allowed": false
  },
  "window_policy": {
    "duration_s": "10",
    "within_sequence_overlap_allowed": false,
    "cross_sequence_windows_allowed": true,
    "minimum_start_separation_within_sequence_s": "10",
    "required_positive_windows": 2,
    "required_below_reference_windows": 2,
    "selection": "Consume the pose-ranked positive and below queues in frozen order. A geometry result may determine which queue still needs evidence, but may not reorder or invent windows."
  },
  "geometry_gates": {
    "maximum_pair_dt_s": "0.100",
    "maximum_pose_bracket_s": "0.100",
    "minimum_pair_geometry_coverage": "0.8",
    "depth_sample_stride_px": 8,
    "minimum_radius_px": "8.0",
    "depth_units_per_meter": "5000",
    "below_trigger_reference": "signed_radial_expansion_per_s < 0.01",
    "positive_approach_geometry": "signed_radial_expansion_per_s >= 0.05",
    "minimum_fixed_denominator_role_fraction": "0.8",
    "minimum_longest_role_run_duration_s": "5.0"
  },
  "execution": {
    "default_workers": 8,
    "numeric_relative_tolerance": "1e-12",
    "numeric_absolute_tolerance": "1e-15",
    "rgb_before_geometry_admission": false
