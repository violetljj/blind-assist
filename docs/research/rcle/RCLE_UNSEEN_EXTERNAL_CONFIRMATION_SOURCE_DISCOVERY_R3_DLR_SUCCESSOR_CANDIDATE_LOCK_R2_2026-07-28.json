  "queue_selection_rule": {
    "registry": "All 11 untouched DLR captures having an exact matching RealSense and Vicon member were probed before this lock.",
    "order": "Descending complete 10-second Vicon window upper bound, then ascending RealSense compressed bytes, then lexicographic capture id.",
