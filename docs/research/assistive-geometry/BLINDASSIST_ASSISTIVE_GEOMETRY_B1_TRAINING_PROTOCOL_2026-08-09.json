    },
    "input_nchw": [1, 3, 608, 448],
    "dynamic_k_shape": [1, 3, 3],
    "graph_inputs": ["image", "K"],
    "evaluation_covariate": "up_camera from source pose or future runtime IMU; shared across arms and never used as a label",
    "missing_up_camera_policy": "UNKNOWN_GROUND_GEOMETRY",
    "shared_decoder_feature": {"channels": 48, "stride": 4},
    "depth_head": "released DPT output path, initialized from metric checkpoint",
    "ground_head": "Conv3x3 48-to-16, ReLU, bilinear resize, Conv1x1 logit",
    "band_pooling": "fixed thirds mean pool over stride-4 feature",
    "task_head": "shared MLP 48-to-32 per band then clearance Softplus, three occupancy logits and one confidence logit",
    "confidence_head_primary_output": [3],
    "interface_confidence_output": [3, 3],
    "deployment_operator_budget": ["Conv", "Relu", "Resize", "ReduceMean", "MatMul", "Add", "Mul", "Sigmoid", "Softplus"]
  },
  "ablation_arms": [
    {"id": "A0_DEPTH_ONLY", "active_losses": ["masked_log_depth", "valid_neighbor_log_gradient"], "task_output": "frozen truth-reader postprocess over predicted depth with shared exogenous up_camera"},
    {"id": "A1_PLUS_GROUND", "active_losses": ["masked_log_depth", "valid_neighbor_log_gradient", "ground_bce", "ground_plane_depth"]},
    {"id": "A2_PLUS_CLEARANCE", "active_losses": ["masked_log_depth", "valid_neighbor_log_gradient", "ground_bce", "ground_plane_depth", "clearance_huber", "occupancy_bce"]},
    {"id": "A3_PLUS_FALSE_CLEAR", "active_losses": ["masked_log_depth", "valid_neighbor_log_gradient", "ground_bce", "ground_plane_depth", "clearance_huber", "occupancy_bce", "false_clear_extra"]},
    {"id": "A4_PLUS_CONFIDENCE", "active_losses": ["masked_log_depth", "valid_neighbor_log_gradient", "ground_bce", "ground_plane_depth", "clearance_huber", "occupancy_bce", "false_clear_extra", "confidence_bce"]}
  ],
  "losses": {
    "masked_log_depth": {"lambda": 1.0, "formula": "near-field-weighted mean absolute log-depth error on depth_valid"},
    "valid_neighbor_log_gradient": {"lambda": 0.5, "formula": "horizontal and vertical absolute log-depth gradient error where both neighboring pixels are depth_valid"},
    "ground_bce": {"lambda": 0.5, "formula": "binary cross entropy on ground_valid pixels"},
    "ground_plane_depth": {"lambda": 0.25, "formula": "absolute predicted-depth point-to-frozen-truth-plane residual on truth ground support"},
    "clearance_huber": {"lambda": 1.0, "delta_m": 0.25, "formula": "Huber on clearance_valid bands"},
    "occupancy_bce": {"lambda": 1.0, "formula": "symmetric BCE on occupancy_valid band-horizon pairs"},
    "false_clear_extra": {"lambda": 2.0, "formula": "truth-occupied-only softplus(-occupancy_logit); with occupancy_bce gives total positive weight 3", "effective_total_positive_weight": 3.0},
    "confidence_bce": {"lambda": 0.5, "formula": "BCE against detached band correctness on deterministic-valid bands"}
  },
  "near_field_weighting": {
    "0.25_to_2m": 3.0,
    "2_to_5m": 2.0,
    "5_to_6m": 1.0
  },
  "confidence": {
    "primary_shape": [3],
    "interface_expansion": "repeat each band confidence across three horizons",
    "correctness_when_clearance_observed": "abs(predicted_clearance_m-truth_clearance_m)<=0.25 AND all three valid horizon decisions correct",
    "correctness_when_clearance_censored_clear": "all three horizons truth-clear and valid AND all three predicted probabilities below 0.5",
