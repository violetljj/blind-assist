      "clearance_valid": {"shape_per_sample": [3], "dtype": "bool", "meaning": "observed intrusion has a finite clearance target"},
      "occupancy_probability": {"shape_per_sample": [3, 3], "dtype": "float32", "target_values": [0.0, 1.0]},
      "occupancy_valid": {"shape_per_sample": [3, 3], "dtype": "bool", "meaning": "truth reader observed enough forward support for this band and horizon"},
      "band_task_confidence": {"shape_per_sample": [3], "dtype": "float32", "target_values": [0.0, 1.0]}
    },
    "clear_without_intrusion_is_censored": true,
    "clearance_loss_on_censored_clear": false,
    "occupancy_loss_on_observed_censored_clear": true,
    "deterministic_unknown_has_zero_loss_weight": true
